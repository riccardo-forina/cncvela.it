94.5 z M 234.5,791 L 238,794 L 236,796 L 233,794 L 234.5,791 z M 203,804.5 L 205.5,807.5 L 203.5,811.5 L 198.5,811.5 L 198,809 L 203,804.5 z M 165.5,834.5 L 173,839 L 172,841.5 L 168.5,840.5 L 165.5,834.5 z M 178.5,849 L 183.5,850 L 186,852.5 L 184,857 L 180.5,854.5 L 178.5,849 z" />
        </g>
      </svg>
      
      <!-- Icons: precise, fixed-size, nothing but arrows/dots/logo on the
           lake itself. Deliberately NOT paired with their label in the same
           flex box — see the label layer below for why. Each OCR station
           renders TWO markers stacked at the same position: a placeholder
           (visible by default) and a hidden live arrow. The client script
           below toggles between them once it has a reading — this keeps the
           arrow's SVG/rotation markup in one place (here) instead of also
           having to build it in JS. -->
      <div class="absolute inset-0 z-10">
        {stationSlots.map((slot) => {
          const colors = slot.reading ? getWindColor(slot.reading.windKn) : null;
          return (
            <Fragment>
              <!-- Live marker: visible immediately if the server already
                   resolved a reading (JSON stations); otherwise hidden until
                   the client script confirms one (OCR stations). The circle
                   (cx=18, cy=8 of a 36x36 viewBox) is the actual "here"
                   point — see the rotation-pivot note below. -->
              <div
                class="absolute transition-transform duration-300 ease-out"
                style={`top: ${slot.position.top}; left: ${slot.position.left}; transform: translate(-50%, -22.222%); ${slot.reading ? '' : 'display: none;'}`}
                data-live-marker={slot.needsClientUpgrade ? slot.id : undefined}
              >
                <div data-rotate-wrap style={`transform-origin: 50% 22.222%;${slot.reading ? ` transform: rotate(${slot.reading.windDirDeg}deg);` : ''}`}>
                  <svg width="22" height="22" viewBox="0 0 36 36" fill="none" class="drop-shadow-lg">
                    <circle data-arrow-stroke cx="18" cy="8" r="5" fill="transparent" stroke-width="2.5" stroke={colors?.arrow}/>
                    <line data-arrow-stroke x1="18" y1="13" x2="18" y2="30" stroke-width="3" stroke-linecap="round" stroke={colors?.arrow}/>
                    <path data-arrow-stroke d="M18 30 L12 23 M18 30 L24 23" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke={colors?.arrow}/>
                  </svg>
                </div>
              </div>

              <!-- Placeholder marker: visible until a reading is known.
                   Pulses only for OCR stations still waiting on the client
                   script (data-loading — "fetching", not "dead"); a JSON
                   station that failed has nothing left to try, so it just
                   sits static. -->
              <div
                class="absolute transform -translate-x-1/2 -translate-y-1/2 opacity-50"
                style={`top: ${slot.position.top}; left: ${slot.position.left}; ${slot.reading ? 'display: none;' : ''}`}
                data-placeholder-marker={slot.needsClientUpgrade ? slot.id : undefined}
              >
                <span data-loading-pulse class:list={['block w-2.5 h-2.5 rounded-full border-2 border-white/60', { 'animate-pulse': slot.needsClientUpgrade }]}></span>
              </div>
            </Fragment>
          );
        })}

        <!-- Caldè landmark (club location): just the logo — no wind badge,
             no real instrument here. -->
        <div
          class="absolute transform -translate-x-1/2 -translate-y-1/2"
          style={`top: ${CALDE_POSITION.top}; left: ${CALDE_POSITION.left};`}
        >
          <img src="/images/logo-round.svg" alt="CNC" class="w-9 h-9 drop-shadow-lg" />
        </div>
      </div>

      <!-- Connector lines: icon to its (possibly far-off) gutter label, so
           the relationship reads clearly even when they're not close. One
           per station regardless of live/placeholder state — position and
           gutter side don't change on upgrade, only the marker/label do. -->
      <div class="absolute inset-0 z-[15] pointer-events-none">
        {stationSlots.map((slot) => (
          <div class="absolute h-px" style={connectorStyle(slot.position, labelTopFor(slot.id, slot.labelSide), labelXFor(slot.id, slot.labelSide), 0.22)}></div>
        ))}
        <div class="absolute h-px" style={connectorStyle(CALDE_POSITION, CALDE_LABEL_TOP, labelXFor('calde', CALDE_LABEL_SIDE), 0.3)}></div>
      </div>

      <!-- Labels: fixed left/right gutter, own vertical position only.
           Deliberately decoupled from the icon layer above — a label's
           rendered width depends on the browser/OS/font/user font-size
           preference, none of which we control, so trying to keep an
           arrow+label centered together as one flex group is inherently
           unreliable (confirmed: this kept drifting). A label only needs a
           fixed edge anchor (left or right) and to sit roughly level with
           its icon — it never needs to know its own width to be correctly
           positioned. Live/placeholder pair, same pattern as the markers
           above. -->
      <div class="absolute inset-0 z-20">
        {stationSlots.map((slot) => {
          const colors = slot.reading ? getWindColor(slot.reading.windKn) : null;
          const labelTop = labelTopFor(slot.id, slot.labelSide);
          return (
            <Fragment>
              <!-- Live label: visible immediately for a server-resolved
                   reading (JSON stations), hidden until upgraded otherwise
                   (OCR stations). -->
              <div
                class:list={['absolute transform -translate-y-1/2 flex flex-col', labelAlignClass(slot.id, slot.labelSide)]}
                style={`top: ${labelTop}%; ${gutterStyle(slot.id, slot.labelSide)} ${slot.reading ? '' : 'display: none;'}`}
                data-live-label={slot.needsClientUpgrade ? slot.id : undefined}
                data-attribution={slot.attributionUrl}
                data-name={slot.name}
              >
                <div class="speed-badge relative flex flex-col items-center">
                  <span data-pulse class:list={['absolute -inset-1 rounded-lg opacity-25 animate-ping', colors?.pulse]} style="animation-duration: 2.5s;"></span>
                  <div
                    data-badge-box
                    class="badge-box relative px-2 py-1 rounded-lg backdrop-blur-md font-mono font-black text-base leading-none bg-slate-900/85 border border-white/10"
                    style={colors ? `box-shadow: 0 0 25px ${colors.glow}, 0 4px 15px rgba(0,0,0,0.6); border-color: ${colors.border};` : ''}
                  >
                    <span data-speed-value style={colors ? `color: ${colors.text};` : ''}>{slot.reading ? slot.reading.windKn : '--'}</span>
                    <span data-speed-unit class="text-xs ml-1 font-bold opacity-60" style={colors ? `color: ${colors.text};` : ''}>kn</span>
                  </div>
                </div>
                <span class="text-[10px] font-bold tracking-wider mt-1 uppercase whitespace-nowrap text-center flex items-center gap-1" data-name-color style={`text-shadow: 0 2px 6px rgba(0,0,0,0.9);${colors ? ` color: ${colors.text};` : ''}`}>
                  <span class="relative flex h-1.5 w-1.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-400"></span>
                  </span>
                  {slot.name}
                </span>
                <span data-timestamp-live class="text-[9px] font-mono text-white/80 whitespace-nowrap" style="text-shadow: 0 2px 6px rgba(0,0,0,0.9);">{slot.reading?.lastModifiedLabel}</span>
              </div>

              <!-- Placeholder label: visible until a reading is known. -->
              <div
                class:list={['absolute transform -translate-y-1/2 flex flex-col opacity-50', labelAlignClass(slot.id, slot.labelSide)]}
                style={`top: ${labelTop}%; ${gutterStyle(slot.id, slot.labelSide)} ${slot.reading ? 'display: none;' : ''}`}
                data-placeholder-label={slot.needsClientUpgrade ? slot.id : undefined}
              >
                <span class="text-[10px] font-bold tracking-wider uppercase whitespace-nowrap text-white/70" style="text-shadow: 0 2px 6px rgba(0,0,0,0.9);">
                  {slot.name}
                </span>
                <span data-timestamp-placeholder class="text-[9px] font-mono text-white/80 whitespace-nowrap" style="text-shadow: 0 2px 6px rgba(0,0,0,0.9); display: none;"></span>
              </div>
            </Fragment>
          );
        })}

        <div class="absolute transform -translate-y-1/2" style={`top: ${CALDE_LABEL_TOP}%; ${gutterStyle('calde', CALDE_LABEL_SIDE)}`}>
          <span class="text-xs font-bold tracking-wider uppercase whitespace-nowrap text-white" style="text-shadow: 0 2px 6px rgba(0,0,0,0.9);">
            CALDÈ
          </span>
        </div>
      </div>
    </div>

    <!-- Title (Top Left): bare floating text, no card — a map overlay in its
         own right, not visually grouped into a "widget". Anchored to the
         section itself, not the aspect-ratio container above (see legend
         comment below for why: that container can render taller than the
         section and gets top/bottom-clipped by its own overflow-hidden). -->
    <div class="absolute top-8 md:top-4 left-4 z-20 flex items-center gap-2">
      <h1 class="text-lg md:text-xl font-black text-white" style="text-shadow: 0 2px 6px rgba(0,0,0,0.9);">
        {t.title}
        <span class="sr-only">{t.seoTitle}</span>
      </h1>
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
    </div>

    <!-- Wind speed legend overlay (Bottom Right), single column. Anchored to
         the section itself (not the aspect-ratio container above, which can
         render taller than the section and get clipped by its
         overflow-hidden) so it always stays inside the visible map area,
         above the console panel below. -->
    <div class="absolute bottom-3 right-3 z-20 flex flex-col items-end gap-1">
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.5)]"></span>
        <span class="text-[10px] font-mono text-white/90" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">&lt;3kn</span>
        <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">Principianti</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.5)]"></span>
        <span class="text-[10px] font-mono text-white/90" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">3-7kn</span>
        <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">Tutti</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-yellow-400 shadow-[0_0_6px_rgba(250,204,21,0.5)]"></span>
        <span class="text-[10px] font-mono text-white/90" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">7-11kn</span>
        <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">Esperti</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-orange-400 shadow-[0_0_6px_rgba(251,146,60,0.5)]"></span>
        <span class="text-[10px] font-mono text-white/90" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">11-16kn</span>
        <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">Attenzione</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-red-400 shadow-[0_0_6px_rgba(248,113,113,0.5)]"></span>
        <span class="text-[10px] font-mono text-white/90" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">&gt;16kn</span>
        <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">Sconsigliato</span>
      </div>
    </div>

    <!-- Safety disclaimer (Bottom Left): its own overlay, bare text like the
         title and legend, not sharing a group with either. -->
    <div class="absolute bottom-3 left-3 z-20 flex items-start gap-1.5 max-w-[65%]">
      <svg class="w-3.5 h-3.5 text-amber-400/90 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <span class="text-[10px] text-white/70" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9);">{t.disclaimer}</span>
    </div>
  </section>

  <!-- Control Console (Bottom Panel): just the scroll hint now — the
       disclaimer moved up into the legend overlay on the map. -->
  <section class="console-panel bg-slate-950 backdrop-blur-md border-t border-white/20 dark:border-slate-700/50 shrink-0">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 py-3">
      <div class="flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-white/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <p class="text-xs text-white/40">{t.scroll}</p>
      </div>
    </div>
  </section>
</div>

<!-- Real station data: Föhn indicator, temp/pressure/rain table, live webcam.
     Kept as its own section below the hero (not crammed into the hero's
     console panel) so the fixed-height map above keeps its full height. -->
{(foehnStatus || ocrStations.length > 0 || jsonStations.length > 0 || liveWebcams.length > 0) && (
  <section class="bg-slate-950 py-6 space-y-4">
  <div class="max-w-6xl mx-auto px-4 lg:px-6">
    {(foehnStatus || ocrStations.length > 0 || jsonStations.length > 0) && (
        <div class="rounded-xl border border-white/10 bg-black/20 px-4 py-2 divide-y divide-white/10">
          <FoehnIndicator status={foehnStatus} labels={t.foehn} />

          <!-- JSON stations' rows are resolved server-side and rendered
               directly below; OCR stations' rows are appended by the client
               script once OCR succeeds (see the script below) — same
               #station-rows container either way. Starts visible if there's
               already at least one server-rendered row, otherwise hidden
               until the client script finds something to show. -->
          {(ocrStations.length > 0 || jsonStations.length > 0) && (
            <div
              class="pt-2"
              id="station-table"
              data-source-label={t.sourceLabel}
              style={jsonSlots.some((s) => s.reading !== null) ? '' : 'display: none;'}
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-white/40 mb-1.5">
                {t.stationsTitle}
              </p>
              <div id="station-rows">
                {jsonSlots.filter((s) => s.reading !== null).map((slot) => (
                  <div class="flex items-center justify-between gap-3 py-1.5 text-sm text-white/90">
                    <a
                      href={slot.attributionUrl}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="group flex items-center gap-1 min-w-0 font-semibold truncate"
                      aria-label={t.sourceLabel}
                      title={t.sourceLabel}
                    >
                      <span class="truncate group-hover:text-white transition-colors">{slot.name}</span>
                      <svg class="w-3 h-3 text-white/40 group-hover:text-white/80 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                    <div class="flex items-center gap-3 font-mono text-white/80 flex-shrink-0">
                      <span>{slot.reading!.pressureHpa.toFixed(1)}hPa</span>
                      <span class="flex items-center gap-1 text-white/50">
                        <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 2c-.3 0-.6.14-.78.4C9.6 5.3 6 10.7 6 14.5A6 6 0 0018 14.5C18 10.7 14.4 5.3 12.78 2.4A.94.94 0 0012 2z" />
                        </svg>
                        {slot.reading!.rainMm.toFixed(1)}mm
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {liveWebcams.length > 0 && (
        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-white/40 mb-2">
            {t.webcamsTitle}
          </p>
          <div
            id="webcam-carousel"
            class:list={[
              'flex gap-3 overflow-x-auto hide-scrollbar snap-x snap-mandatory -mx-4 px-4 lg:mx-0 lg:px-0',
              { 'justify-center': liveWebcams.length === 1 },
            ]}
          >
            {liveWebcams.map((cam) => (
              <a
                href={cam.attributionUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="group flex-shrink-0 w-[85vw] sm:w-72 md:w-80 snap-start"
              >
                <div class="aspect-[4/3] rounded-lg overflow-hidden bg-black/20">
                  <img
                    src={`/api/webcam/${cam.id}`}
                    alt={cam.name}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
                <p class="mt-2 text-sm font-semibold text-white/90 group-hover:text-white transition-colors truncate">
                  {cam.name}
                </p>
              </a>
            ))}
          </div>

          {liveWebcams.length > 1 && (
            <div id="webcam-carousel-dots" class="flex items-center justify-center gap-1.5 mt-3">
              {liveWebcams.map((_, i) => (
                <span class="webcam-dot w-1.5 h-1.5 rounded-full bg-white/30 transition-colors" data-index={i}></span>
              ))}
            </div>
          )}
        </div>
      )}
  </div>
  </section>
)}

<script>
  // Highlight the current webcam carousel dot as the user scrolls/swipes.
  function initWebcamCarousel() {
    const track = document.getElementById('webcam-carousel');
    const dots = document.querySelectorAll('.webcam-dot');
    if (!track || dots.length === 0) return;

    const updateActiveDot = () => {
      const cards = Array.from(track.children) as HTMLElement[];
      if (cards.length < 2) return;
      const cardWidth = cards[1].offsetLeft - cards[0].offsetLeft;
      const index = cardWidth > 0 ? Math.round(track.scrollLeft / cardWidth) : 0;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === index);
        dot.classList.toggle('bg-white/30', i !== index);
      });
    };

    track.addEventListener('scroll', updateActiveDot, { passive: true });
    updateActiveDot();
  }

  initWebcamCarousel();
</script>

<script>
  // Client-side station OCR. See LakeWindMap.astro's frontmatter comment —
  // this used to run server-side, but tesseract.js's WASM OCR was too slow
  // under Vercel's serverless CPU allocation (Hobby plan caps at 1 vCPU,
  // consistently 10s+ per station in production vs ~1-2s on a normal
  // machine). The browser is tesseract.js's actual designed target
  // (Web Workers, full CPU), so OCR moved here instead — the server now
  // only proxies the ticker image (/api/webcam/[id], freshness-gated same
  // as before) and this script does fetch -> preprocess -> OCR -> parse ->
  // DOM update, per station, after the initial page paint.
  import { createWorker } from 'tesseract.js';
  import { parseTickerText } from '../utils/tickerParser';
  import { getWindColor } from '../utils/windColor';

  // Keep in sync with package.json's tesseract.js version AND
  // public/tesseract/{version}/ — see that directory's own note on why it's
  // versioned (so a future tesseract.js bump ships under a new path with
  // nothing to invalidate).
  const TESSERACT_BASE = '/tesseract/7.0.0';
  const OCR_TIMEOUT_MS = 15000;

  function formatLastUpdated(iso: string): string {
    const minutes = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
    if (minutes < 60) return `agg. ${minutes}m fa`;
    return `agg. ${Math.round(minutes / 60)}h fa`;
  }

  function withTimeout<T>(promise: Promise<T>, ms: number, label: string): Promise<T> {
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error(`${label} timed out after ${ms}ms`)), ms);
      promise.then(
        (value) => { clearTimeout(timer); resolve(value); },
        (error) => { clearTimeout(timer); reject(error); }
      );
    });
  }

  // Mirrors the old server-side sharp pipeline (resize 6x with lanczos3,
  // grayscale, threshold at 180) as closely as Canvas allows — the browser's
  // own upscale filter isn't identically lanczos3, so OCR accuracy here
  // isn't guaranteed pixel-identical to what the regex was originally tuned
  // against. Worth spot-checking real stations after this ships.
  async function preprocessTickerImage(blob: Blob): Promise<HTMLCanvasElement> {
    const bitmap = await createImageBitmap(blob);
    const targetWidth = bitmap.width * 6;
    const targetHeight = bitmap.height * 6;
    const canvas = document.createElement('canvas');
    canvas.width = targetWidth;
    canvas.height = targetHeight;
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(bitmap, 0, 0, targetWidth, targetHeight);

    const imageData = ctx.getImageData(0, 0, targetWidth, targetHeight);
    const data = imageData.data;
    for (let i = 0; i < data.length; i += 4) {
      const gray = data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;
      const value = gray >= 180 ? 255 : 0;
      data[i] = value;
      data[i + 1] = value;
      data[i + 2] = value;
    }
    ctx.putImageData(imageData, 0, 0);
    return canvas;
  }

  let workerPromise: ReturnType<typeof createWorker> | null = null;
  function getWorker() {
    if (!workerPromise) {
      workerPromise = createWorker('eng', 1, {
        workerPath: `${TESSERACT_BASE}/worker.min.js`,
        corePath: TESSERACT_BASE,
        langPath: TESSERACT_BASE,
        gzip: false,
      }).then(async (worker) => {
        await worker.setParameters({
          tessedit_pageseg_mode: '7' as any, // single text line
          tessedit_char_whitelist: '0123456789.,°CNSEWkmh/PahT% ',
        });
        return worker;
      });
    }
    return workerPromise;
  }

  const RAIN_ICON_SVG =
    '<svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c-.3 0-.6.14-.78.4C9.6 5.3 6 10.7 6 14.5A6 6 0 0018 14.5C18 10.7 14.4 5.3 12.78 2.4A.94.94 0 0012 2z" /></svg>';
  const LINK_ICON_SVG =
    '<svg class="w-3 h-3 text-white/40 group-hover:text-white/80 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>';

  // Mirrors what used to be StationReadingRow.astro — that component was
  // removed since Astro server components can't be invoked from client JS;
  // this is the one place that markup exists now.
  function addTableRow(
    container: Element,
    sourceLabel: string,
    row: { name: string; attributionUrl: string; pressureHpa: number; rainMm: number }
  ) {
    const el = document.createElement('div');
    el.className = 'flex items-center justify-between gap-3 py-1.5 text-sm text-white/90';
    el.innerHTML = `
      <a href="${row.attributionUrl}" target="_blank" rel="noopener noreferrer nofollow" class="group flex items-center gap-1 min-w-0 font-semibold truncate" aria-label="${sourceLabel}" title="${sourceLabel}">
        <span class="truncate group-hover:text-white transition-colors">${row.name}</span>
        ${LINK_ICON_SVG}
      </a>
      <div class="flex items-center gap-3 font-mono text-white/80 flex-shrink-0">
        <span>${row.pressureHpa.toFixed(1)}hPa</span>
        <span class="flex items-center gap-1 text-white/50">${RAIN_ICON_SVG}${row.rainMm.toFixed(1)}mm</span>
      </div>
    `;
    container.appendChild(el);
  }

  // Stops the placeholder's "fetching" pulse once a station has settled into
  // a definitive state — live (marker/label are swapped in applyReading, so
  // the pulsing dot is hidden anyway), stale, or genuinely unreachable.
  function stopLoadingPulse(id: string) {
    document.querySelector(`[data-placeholder-marker="${id}"] [data-loading-pulse]`)?.classList.remove('animate-pulse');
  }

  function applyStale(id: string, lastModifiedIso: string) {
    const placeholderLabel = document.querySelector(`[data-placeholder-label="${id}"]`);
    const timestamp = placeholderLabel?.querySelector<HTMLElement>('[data-timestamp-placeholder]');
    if (!timestamp) return;
    timestamp.textContent = formatLastUpdated(lastModifiedIso);
    timestamp.style.display = '';
  }

  function applyReading(
    id: string,
    reading: { windKn: number; windDirDeg: number; pressureHpa: number; rainMm: number; lastModified: string }
  ) {
    const liveMarker = document.querySelector<HTMLElement>(`[data-live-marker="${id}"]`);
    const placeholderMarker = document.querySelector<HTMLElement>(`[data-placeholder-marker="${id}"]`);
    const liveLabel = document.querySelector<HTMLElement>(`[data-live-label="${id}"]`);
    const placeholderLabel = document.querySelector<HTMLElement>(`[data-placeholder-label="${id}"]`);
    if (!liveMarker || !placeholderMarker || !liveLabel || !placeholderLabel) return;

    const colors = getWindColor(reading.windKn);

    const rotateWrap = liveMarker.querySelector<HTMLElement>('[data-rotate-wrap]');
    if (rotateWrap) rotateWrap.style.transform = `rotate(${reading.windDirDeg}deg)`;
    liveMarker.querySelectorAll('[data-arrow-stroke]').forEach((el) => el.setAttribute('stroke', colors.arrow));

    const badgeBox = liveLabel.querySelector<HTMLElement>('[data-badge-box]');
    if (badgeBox) {
      badgeBox.style.boxShadow = `0 0 25px ${colors.glow}, 0 4px 15px rgba(0,0,0,0.6)`;
      badgeBox.style.borderColor = colors.border;
    }
    const speedValue = liveLabel.querySelector<HTMLElement>('[data-speed-value]');
    if (speedValue) {
      speedValue.textContent = String(reading.windKn);
      speedValue.style.color = colors.text;
    }
    const speedUnit = liveLabel.querySelector<HTMLElement>('[data-speed-unit]');
    if (speedUnit) speedUnit.style.color = colors.text;
    const nameColor = liveLabel.querySelector<HTMLElement>('[data-name-color]');
    if (nameColor) nameColor.style.color = colors.text;
    const pulse = liveLabel.querySelector<HTMLElement>('[data-pulse]');
    if (pulse) pulse.className = `absolute -inset-1 rounded-lg opacity-25 animate-ping ${colors.pulse}`;
    const timestampLive = liveLabel.querySelector<HTMLElement>('[data-timestamp-live]');
    if (timestampLive) timestampLive.textContent = formatLastUpdated(reading.lastModified);

    liveMarker.style.display = '';
    placeholderMarker.style.display = 'none';
    liveLabel.style.display = 'flex';
    placeholderLabel.style.display = 'none';

    const tableContainer = document.getElementById('station-table');
    const rowsContainer = document.getElementById('station-rows');
    if (tableContainer && rowsContainer) {
      addTableRow(rowsContainer, tableContainer.dataset.sourceLabel || '', {
        name: liveLabel.dataset.name || id,
        attributionUrl: liveLabel.dataset.attribution || '#',
        pressureHpa: reading.pressureHpa,
        rainMm: reading.rainMm,
      });
      tableContainer.style.display = '';
    }
  }

  async function upgradeStation(id: string) {
    try {
      let response: Response;
      try {
        response = await fetch(`/api/webcam/${id}`);
      } catch {
        return; // unreachable — stays a plain placeholder, nothing to show
      }

      const lastModifiedHeader = response.headers.get('last-modified');
      const lastModifiedIso = lastModifiedHeader ? new Date(lastModifiedHeader).toISOString() : null;

      if (response.status === 503) {
        // Stale: source reachable but too old to trust — still show "last seen".
        if (lastModifiedIso) applyStale(id, lastModifiedIso);
        return;
      }
      if (!response.ok) return; // 404: genuinely unreachable this round

      try {
        const blob = await response.blob();
        const canvas = await preprocessTickerImage(blob);
        const worker = await withTimeout(getWorker(), OCR_TIMEOUT_MS, `tesseract init for ${id}`);
        const { data } = await withTimeout(worker.recognize(canvas), OCR_TIMEOUT_MS, `OCR for ${id}`);
        const reading = parseTickerText(data.text, lastModifiedIso ?? new Date().toISOString());
        if (reading) {
          applyReading(id, reading);
        } else if (lastModifiedIso) {
          applyStale(id, lastModifiedIso);
        }
      } catch (error) {
        console.error(`Client-side OCR failed for station ${id}:`, error);
        if (lastModifiedIso) applyStale(id, lastModifiedIso);
      }
    } finally {
      stopLoadingPulse(id);
    }
  }

  function initStationOcr() {
    const ids = Array.from(document.querySelectorAll<HTMLElement>('[data-placeholder-marker]')).map(
      (el) => el.dataset.placeholderMarker!
    );
    ids.forEach((id) => upgradeStation(id));
  }

  initStationOcr();
</script>

