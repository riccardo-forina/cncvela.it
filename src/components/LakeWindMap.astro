          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.5)" stroke-width="1.5" d="M 33,678 L 33,684 L 58,709 L 69,716 L 78,712 L 85,703 L 81,694 L 60,680 L 49,676 L 33,678 z" />
          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.6)" stroke-width="2" d="M 751,65 L 743,78 L 731,83 L 705,87 L 693,90 L 698,105 L 698,118 L 694,120 L 699,123 L 696,133 L 699,139 L 696,145 L 685,149 L 675,159 L 665,159 L 652,153 L 639,147 L 631,134 L 622,140 L 618,137 L 600,148 L 595,145 L 581,151 L 564,157 L 558,169 L 552,176 L 542,189 L 534,207 L 532,219 L 529,223 L 528,232 L 519,241 L 519,248 L 516,254 L 506,261 L 506,269 L 499,280 L 494,287 L 494,300 L 489,307 L 489,327 L 494,334 L 493,344 L 498,352 L 491,362 L 501,368 L 497,376 L 503,372 L 506,396 L 512,402 L 513,408 L 520,415 L 514,427 L 520,442 L 522,457 L 527,460 L 526,478 L 513,489 L 499,497 L 482,498 L 478,508 L 472,512 L 470,508 L 460,507 L 453,523 L 441,534 L 431,551 L 424,570 L 417,587 L 403,594 L 397,609 L 386,626 L 373,642 L 370,652 L 366,654 L 361,677 L 354,685 L 344,692 L 328,705 L 317,717 L 310,720 L 299,728 L 293,729 L 282,737 L 271,742 L 266,757 L 257,761 L 258,768 L 247,792 L 246,797 L 230,784 L 224,783 L 205,756 L 188,751 L 165,739 L 152,733 L 148,735 L 136,730 L 144,739 L 141,740 L 126,736 L 120,740 L 111,743 L 103,748 L 95,757 L 94,764 L 109,772 L 128,794 L 134,796 L 140,803 L 145,814 L 142,816 L 142,825 L 149,828 L 149,836 L 162,856 L 168,858 L 168,863 L 173,867 L 178,864 L 186,868 L 196,877 L 207,879 L 214,883 L 229,889 L 241,897 L 256,918 L 262,939 L 262,948 L 269,981 L 275,1003 L 271,1011 L 265,1022 L 258,1029 L 260,1034 L 262,1055 L 254,1062 L 248,1063 L 245,1073 L 234,1078 L 226,1069 L 217,1083 L 220,1091 L 213,1096 L 215,1110 L 205,1118 L 214,1133 L 212,1137 L 219,1179 L 225,1192 L 236,1201 L 237,1206 L 254,1217 L 252,1232 L 265,1241 L 267,1248 L 260,1253 L 263,1256 L 264,1261 L 285,1277 L 290,1283 L 289,1288 L 292,1291 L 292,1299 L 298,1307 L 295,1315 L 301,1322 L 311,1322 L 323,1316 L 325,1318 L 331,1315 L 340,1317 L 361,1320 L 377,1326 L 376,1319 L 362,1313 L 367,1308 L 362,1303 L 350,1314 L 338,1312 L 336,1305 L 340,1297 L 335,1290 L 329,1294 L 322,1293 L 321,1283 L 320,1270 L 316,1248 L 311,1240 L 303,1235 L 295,1238 L 295,1236 L 295,1229 L 290,1216 L 285,1214 L 285,1207 L 290,1199 L 297,1197 L 301,1189 L 294,1193 L 290,1192 L 285,1192 L 276,1193 L 267,1194 L 264,1188 L 262,1182 L 254,1173 L 257,1164 L 256,1157 L 258,1145 L 262,1129 L 263,1116 L 269,1110 L 282,1110 L 291,1114 L 300,1119 L 303,1114 L 309,1114 L 310,1112 L 315,1114 L 321,1112 L 329,1101 L 335,1096 L 339,1087 L 336,1062 L 344,1054 L 346,1049 L 350,1043 L 359,1049 L 372,1041 L 373,1026 L 368,1017 L 365,994 L 359,976 L 361,964 L 354,969 L 344,960 L 342,950 L 334,938 L 332,923 L 325,908 L 318,904 L 315,896 L 321,891 L 321,879 L 316,865 L 306,863 L 311,848 L 317,829 L 322,819 L 333,820 L 348,818 L 355,816 L 353,805 L 340,796 L 343,790 L 348,786 L 352,779 L 362,773 L 372,769 L 384,762 L 388,755 L 396,745 L 405,734 L 412,729 L 423,731 L 432,722 L 436,712 L 436,702 L 438,693 L 454,677 L 463,668 L 471,666 L 475,659 L 484,659 L 490,654 L 499,647 L 507,636 L 520,628 L 527,619 L 529,604 L 528,591 L 534,592 L 542,588 L 545,580 L 550,571 L 563,569 L 573,566 L 580,558 L 586,553 L 594,542 L 600,533 L 603,522 L 606,508 L 604,502 L 604,491 L 599,483 L 598,478 L 594,469 L 586,463 L 576,457 L 567,451 L 567,445 L 568,432 L 566,426 L 569,419 L 568,411 L 561,395 L 563,384 L 565,372 L 561,360 L 552,355 L 549,344 L 544,336 L 547,325 L 555,316 L 564,308 L 570,297 L 572,281 L 578,275 L 605,276 L 608,273 L 618,271 L 627,260 L 635,248 L 645,238 L 656,229 L 662,219 L 669,219 L 671,215 L 679,211 L 689,203 L 691,197 L 698,192 L 705,183 L 718,179 L 727,175 L 739,173 L 756,170 L 764,166 L 767,159 L 779,158 L 788,155 L 794,149 L 799,144 L 797,136 L 797,132 L 817,129 L 810,128 L 809,125 L 796,124 L 792,120 L 798,119 L 792,116 L 797,115 L 792,113 L 790,108 L 795,105 L 801,98 L 803,85 L 796,99 L 790,102 L 786,92 L 772,79 L 769,68 L 751,65 z M 572,188 L 572.5,190.5 L 570.5,193.5 L 572.5,196.5 L 570,199.5 L 566,201 L 567.5,195 L 568.5,191 L 572,188 z M 515.5,494.5 L 520.5,495 L 515.5,498.5 L 515.5,494.5 z M 234.5,791 L 238,794 L 236,796 L 233,794 L 234.5,791 z M 203,804.5 L 205.5,807.5 L 203.5,811.5 L 198.5,811.5 L 198,809 L 203,804.5 z M 165.5,834.5 L 173,839 L 172,841.5 L 168.5,840.5 L 165.5,834.5 z M 178.5,849 L 183.5,850 L 186,852.5 L 184,857 L 180.5,854.5 L 178.5,849 z" />
        </g>
      </svg>
      
      <!-- Wind Markers -->
      <div class="absolute inset-0 z-10">
        {windData.map((data) => (
          <div 
            class="wind-marker absolute transform -translate-x-1/2 -translate-y-1/2 flex items-center gap-2 transition-all duration-300 ease-out hover:scale-110 hover:z-50"
            style={`top: ${data.position.top}; left: ${data.position.left};`}
          >
            <!-- Arrow -->
            <div class="wind-arrow" style={`transform: rotate(${data.windDirection}deg);`}>
              <svg width="36" height="36" viewBox="0 0 36 36" fill="none" class="drop-shadow-lg">
                <circle cx="18" cy="8" r="5" fill="transparent" stroke={data.colors.arrow} stroke-width="2.5"/>
                <line x1="18" y1="13" x2="18" y2="30" stroke={data.colors.arrow} stroke-width="3" stroke-linecap="round"/>
                <path d="M18 30 L12 23 M18 30 L24 23" stroke={data.colors.arrow} stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            
            <!-- Badge -->
            <div class="speed-badge relative flex flex-col items-center">
              <span class={`absolute -inset-1 rounded-lg opacity-25 animate-ping ${data.colors.pulse}`} style="animation-duration: 2.5s;"></span>
              <div 
                class="badge-box relative px-3 py-1.5 rounded-lg backdrop-blur-md font-mono font-black text-xl leading-none bg-slate-900/85 border border-white/10"
                style={`box-shadow: 0 0 25px ${data.colors.glow}, 0 4px 15px rgba(0,0,0,0.6); border-color: ${data.colors.border};`}
              >
                <span style={`color: ${data.colors.text};`}>{fetchError ? '--' : data.windSpeed}</span>
                <span class="text-sm ml-1 font-bold opacity-60" style={`color: ${data.colors.text};`}>kn</span>
              </div>
              <span class="text-xs font-bold tracking-wider mt-1.5 uppercase whitespace-nowrap text-center" style={`color: ${data.colors.text}; text-shadow: 0 2px 6px rgba(0,0,0,0.9);`}>
                {data.name}
              </span>
              {data.id === 'calde' && <img src="/images/logo-round.svg" alt="CNC" class="w-8 h-8 mt-1.5" />}
            </div>
          </div>
        ))}
      </div>
      
      <!-- Weather Widget (Top Left) -->
      {todayWeather && (
        <div class="absolute top-8 md:top-4 left-4 z-20 flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-900/80 backdrop-blur-md border border-white/10 shadow-[0_0_15px_rgba(0,0,0,0.4)]">
