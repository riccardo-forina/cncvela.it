---
/**
 * LakeWindMap.astro - Premium Tactical Wind Map for Lake Maggiore
 * 
 * Full-viewport hero with holographic lake visualization and live wind data.
 * Uses ICON-D2 model for high-resolution Alpine weather forecasts.
 */

import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
  todayWeather?: {
    icon: string;
    tempMax: number;
    tempMin: number;
  };
}

const { locale = 'it', todayWeather } = Astro.props;

// Strategic coordinates for Lake Maggiore
const LOCATIONS = [
  { 
    id: 'maccagno', 
    name: 'MACCAGNO', 
    lat: 46.043, 
    lon: 8.738,
    position: { top: '24%', left: '72%' } 
  },
  { 
    id: 'calde', 
    name: 'CALDÈ', 
    lat: 45.947, 
    lon: 8.649,
    position: { top: '48%', left: '62%' } 
  },
  { 
    id: 'ispra', 
    name: 'ISPRA', 
    lat: 45.813, 
    lon: 8.610,
    position: { top: '78%', left: '44%' } 
  },
] as const;

// Convert km/h to knots
const kmhToKnots = (kmh: number): number => Math.round(kmh * 0.5399);

// Get wind color based on knots
const getWindColor = (knots: number) => {
  if (knots < 3) {
    return {
      arrow: '#38bdf8',
      badge: 'rgba(56, 189, 248, 0.15)',
      border: 'rgba(56, 189, 248, 0.4)',
      text: '#7dd3fc',
      glow: 'rgba(56, 189, 248, 0.3)',
      pulse: 'bg-sky-400',
    };
  } else if (knots < 7) {
    return {
      arrow: '#34d399',
      badge: 'rgba(52, 211, 153, 0.15)',
      border: 'rgba(52, 211, 153, 0.5)',
      text: '#6ee7b7',
      glow: 'rgba(52, 211, 153, 0.4)',
      pulse: 'bg-emerald-400',
    };
  } else if (knots < 11) {
    return {
      arrow: '#fbbf24',
      badge: 'rgba(251, 191, 36, 0.15)',
      border: 'rgba(251, 191, 36, 0.5)',
      text: '#fcd34d',
      glow: 'rgba(251, 191, 36, 0.4)',
      pulse: 'bg-amber-400',
    };
  } else if (knots < 16) {
    return {
      arrow: '#fb923c',
      badge: 'rgba(251, 146, 60, 0.2)',
      border: 'rgba(251, 146, 60, 0.6)',
      text: '#fdba74',
      glow: 'rgba(251, 146, 60, 0.5)',
      pulse: 'bg-orange-400',
    };
  } else {
    return {
      arrow: '#f87171',
      badge: 'rgba(248, 113, 113, 0.2)',
      border: 'rgba(248, 113, 113, 0.6)',
      text: '#fca5a5',
      glow: 'rgba(248, 113, 113, 0.5)',
      pulse: 'bg-red-400',
    };
  }
};

// Fetch wind data
interface WindData {
  id: string;
  name: string;
  position: { top: string; left: string };
  windSpeed: number;
  windDirection: number;
  colors: ReturnType<typeof getWindColor>;
}

let windData: WindData[] = [];
let fetchError = false;

try {
  const responses = await Promise.all(
    LOCATIONS.map(loc =>
      fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${loc.lat}&longitude=${loc.lon}&current=wind_speed_10m,wind_direction_10m&models=icon_d2&timezone=Europe/Rome`
      ).then(res => {
        if (!res.ok) throw new Error(`Failed to fetch data for ${loc.name}`);
        return res.json();
      })
    )
  );

  windData = responses.map((data, index) => {
    const loc = LOCATIONS[index];
    const windSpeedKmh = data.current?.wind_speed_10m ?? 0;
    const windSpeedKn = kmhToKnots(windSpeedKmh);
    const windDirection = data.current?.wind_direction_10m ?? 0;
    
    return {
      id: loc.id,
      name: loc.name,
      position: loc.position,
      windSpeed: windSpeedKn,
      windDirection,
      colors: getWindColor(windSpeedKn),
    };
  });
} catch (error) {
  console.error('Error fetching wind data:', error);
  fetchError = true;
  
  windData = LOCATIONS.map(loc => ({
    id: loc.id,
    name: loc.name,
    position: loc.position,
    windSpeed: 0,
    windDirection: 0,
    colors: getWindColor(0),
  }));
}

// Translations
const t = {
  title: { it: 'Meteo Live', en: 'Live Weather', de: 'Live Wetter' },
  legend: { it: 'Legenda', en: 'Legend', de: 'Legende' },
  model: { it: 'Modello ICON-D2 (High Res)', en: 'ICON-D2 Model (High Res)', de: 'ICON-D2-Modell (High Res)' },
  scroll: { it: 'Scorri per dettagli', en: 'Scroll for details', de: 'Scrollen für Details' },
  disclaimer: { it: 'Osservare sempre il lago prima di uscire', en: 'Always check the lake before going out', de: 'Überprüfen Sie immer den See, bevor Sie losfahren' },
};

const tl = (key: keyof typeof t) => t[key][locale] || t[key].it;
---

<!-- Full viewport hero -->
