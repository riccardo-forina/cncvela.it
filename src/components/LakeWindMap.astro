---
/**
 * LakeWindMap.astro - Premium Tactical Wind Map for Lake Maggiore
 *
 * Full-viewport hero with holographic lake visualization. Maccagno, Pino
 * Tronzano and Meina show real OCR'd shore-station readings.
 *
 * LAYOUT RULE — read before adding content to this component:
 * The `.lake-wind-hero` div (below) is HEIGHT-LOCKED to the viewport
 * (`h-[calc(100svh-...)]`) so the map fills the screen on load. Title
 * ("Meteo Live" + live dot, top-left), the wind-speed legend (bottom-right)
 * and the safety disclaimer (bottom-left) are three separate, independent
 * map overlays — not stacked/grouped with each other, and not separate rows
 * below the map. Every row added below the map eats into the map's own
 * height and squeezes the SVG and its markers into a smaller box (this
 * happened once already: adding the Föhn indicator/station table/webcam
 * there made the map "not full height" with arrows too cramped to see).
 * What's left below the map — the `console-panel`, just the centered
 * scroll-hint now — must stay minimal for the same reason. Any new data/UI
 * belongs in the separate <section> rendered AFTER `.lake-wind-hero`
 * closes, in normal page flow below the fold — not inside the hero. The
 * title/legend/disclaimer overlays are anchored to the map `<section>`
 * itself, not the aspect-ratio container inside it — that container can
 * render taller than the section and gets top/bottom-clipped by its own
 * overflow-hidden, which would clip a bottom/top-anchored overlay along
 * with it.
 */

import type { Locale } from '../i18n';
import { getActiveStations, localizeStationName } from '../utils/meteoStations';
import { getProxiedImage } from '../utils/webcams';
import { getFoehnStatus } from '../utils/foehn';
import { getLiveVcoReading } from '../utils/liveVcoStation';
import { getWindColor } from '../utils/windColor';
import FoehnIndicator from './FoehnIndicator.astro';

interface MapTranslations {
  title: string;
  seoTitle: string;
  ariaLabel: string;
  mapAlt: string;
  scroll: string;
  disclaimer: string;
  sourceLabel: string;
  stationsTitle: string;
  webcamsTitle: string;
  foehn: {
    title: string;
    bassa: string;
    moderata: string;
    alta: string;
    disclaimer: string;
  };
}

interface Props {
  locale?: Locale;
  translations: MapTranslations;
}

const { locale = 'it', translations: t } = Astro.props;

// Caldè: club home, plain landmark pin — no wind badge, since there's no real
// instrument there (dropped the old forecast-only badge: misleading to show
// a model guess right next to real station readings).
const CALDE_LATLON = { lat: 45.947, lon: 8.649 };

// The map's SVG below is hand-drawn, not a true geographic projection. These
// 3 points (Maccagno, Caldè, Ispra) were the original hand-placed marker
// positions (in the tight, unpadded 0-100 coordinate space the SVG viewBox
// used before the zoom-out margin below was added) — Ispra itself is no
// longer shown on the map, but its anchor point is kept here purely as
// calibration data for the affine fallback below. Solving the lat/lon ->
// %position transform they imply lets us place any other station's real
// coordinates on the same map without re-eyeballing by hand — see the plan
// doc for the derivation and caveats (weaker across the lake's width, since
// all 3 anchors sit on the east shore).
const MAP_ANCHORS = [
  { lat: 46.043, lon: 8.738, top: 24, left: 72 }, // Maccagno
  { lat: CALDE_LATLON.lat, lon: CALDE_LATLON.lon, top: 48, left: 62 }, // Caldè
  { lat: 45.813, lon: 8.610, top: 78, left: 44 }, // Ispra (calibration only)
];

function det3(m: number[][]): number {
  return (
    m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) -
    m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) +
    m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0])
  );
}

function solveAffine(rows: { lat: number; lon: number; value: number }[]): [number, number, number] {
  const A = rows.map((r) => [r.lat, r.lon, 1]);
  const b = rows.map((r) => r.value);
  const D = det3(A);
  const solveFor = (col: number) => {
    const Ai = A.map((row) => [...row]);
    for (let r = 0; r < 3; r++) Ai[r][col] = b[r];
    return det3(Ai) / D;
  };
  return [solveFor(0), solveFor(1), solveFor(2)];
}

const topCoef = solveAffine(MAP_ANCHORS.map((a) => ({ lat: a.lat, lon: a.lon, value: a.top })));
const leftCoef = solveAffine(MAP_ANCHORS.map((a) => ({ lat: a.lat, lon: a.lon, value: a.left })));

// "Zoom out": the affine transform above places markers tight against the
// map's edges (e.g. Pino Tronzano at top:12%, Meina at bottom:86%), which on
// a mobile-height viewport left them cramped against the weather-widget/
// scroll-hint overlays and hard to notice. Pad every position toward the
// center by this margin (applied to both the SVG viewBox and every marker's
// %, so the lake shape and the markers stay in sync).
const ZOOM_OUT_MARGIN_PCT = 15;
const zoomOut = (pct: number): number => ZOOM_OUT_MARGIN_PCT + pct * (1 - (2 * ZOOM_OUT_MARGIN_PCT) / 100);

function formatPosition(top: number, left: number): { top: string; left: string } {
  return { top: `${zoomOut(top).toFixed(1)}%`, left: `${zoomOut(left).toFixed(1)}%` };
}

// The affine transform below is a fallback ONLY — it's not reliable enough
// to trust directly (confirmed: even the 3 *original* hand-placed anchors
// it was built from landed off the actual lake shape when checked against
// real rendered pixels, and extrapolating from already-wrong anchors
// compounded the error for everything else).
//
// Every station actually in use has an explicit override below, computed by
// `scripts/compute-station-positions.mjs`: it walks the real drawn
// shoreline polygon and places each station by real latitude, proportional
// arc-length along the correct shore chain — the result is on the
// shoreline *by construction*, not a guess that gets checked afterward.
// That script also runs two automated checks (north-south order matches
// real latitude; every point samples as lake-colored on the actual
// rasterized SVG) and writes a debug render to look at before trusting the
// output. Adding or moving a station: edit the STATIONS list in that
// script, re-run it, paste the printed values in here — don't hand-tune
// these numbers directly.
const POSITION_OVERRIDES: Record<string, { top: number; left: number }> = {
  // left nudged from the script's on-shore output (69.1) to sit visibly on/in
  // the water rather than right at the shoreline edge, which read as "off
  // the lake" at this zoom level — a perpendicular nudge, unlike
  // fractionNudge in the script (which only moves along the shore). Nudged
  // back right slightly to give the arrow icon more breathing room.
  'pino-tronzano': { top: 19.4, left: 68.5 },
  maccagno: { top: 27.6, left: 63.5 },
  // left nudged further west (from the script's on-shore output, 14.7) for
  // more clearance around the arrow icon.
  baveno: { top: 52.4, left: 11 },
  belgirate: { top: 67.8, left: 29.7 },
  meina: { top: 80.6, left: 24.2 },
  arona: { top: 88.7, left: 30.2 },
};

function latLonToPosition(id: string, lat: number, lon: number): { top: string; left: string } {
  const override = POSITION_OVERRIDES[id];
  if (override) return formatPosition(override.top, override.left);
  const top = topCoef[0] * lat + topCoef[1] * lon + topCoef[2];
  const left = leftCoef[0] * lat + leftCoef[1] * lon + leftCoef[2];
  return formatPosition(top, left);
}

// Computed by scripts/compute-station-positions.mjs — see POSITION_OVERRIDES comment above.
const CALDE_POSITION = formatPosition(50.2, 49.3);
const CALDE_LABEL_SIDE: LabelSide = 'right';

// Labels are deliberately NOT laid out next to their arrow via flexbox —
// a label's rendered width depends on the browser/OS/font/user font-size
// preference, none of which we control, so "centering" a mixed arrow+label
// group on a coordinate is inherently unreliable (this is exactly what kept
// going wrong). Instead: arrows sit at the *precise* computed position (a
// fixed-size SVG we fully control), and labels live in one of two fixed
// gutters (left or right edge of the map) at the same vertical position,
// entirely decoupled from the arrow's own layout.
//
// Gutter side is a LAYOUT choice, not a geography one — with 5 west-shore
// stations now, all-on-the-left is geographically tidy but leaves the left
// gutter overcrowded and the right one empty. Belgirate and Arona are
// deliberately assigned to the right gutter despite being on the west
// shore, and Pino Tronzano likewise despite being east shore; the diagonal
// connector line (connectorStyle) is what makes this readable, drawing a
// line across the lake back to the real icon instead of implying the label
// sits next to it.
type LabelSide = 'left' | 'right';
const LEFT_GUTTER_STATIONS = new Set(['meina', 'baveno']);
const labelSideFor = (id: string): LabelSide => (LEFT_GUTTER_STATIONS.has(id) ? 'left' : 'right');

// Gutters for labels, as a percentage of the map box — this same constant
// drives both the label's own position (below) and the connector-line math,
// so they can't drift apart the way a separate Tailwind `left-2`/`right-2`
// (rem-based) and a percentage-based line calculation previously could.
// Pulled in from the very edge (was 3/97) now that icon positions are
// precise and trustworthy — shorter connector lines read as more clearly
// "this label belongs to that icon" than a wire spanning the whole map.
const GUTTER_LEFT_PCT = 12;
const GUTTER_RIGHT_PCT = 88;

// Per-station label position overrides, replacing the standard edge gutter.
// `fromLeft` anchors the label's left edge and grows the text rightward
// (safe for open-canvas positions, like Belgirate/Arona sitting over the
// small ponds south-east of the main channel — picked from those <path>
// elements' own bounding boxes in the SVG below). `fromRight` anchors the
// right edge and grows leftward instead (safe for a label pushed further
// toward the right edge than the standard gutter, like Pino Tronzano here —
// growing rightward would run it off-canvas). Nudge these by eye against a
// screenshot if they don't land cleanly.
type LabelOverride = { fromLeft: number } | { fromRight: number };
const LABEL_POSITION_OVERRIDES: Record<string, LabelOverride> = {
  belgirate: { fromLeft: 42 },
  arona: { fromLeft: 40 },
  baveno: { fromLeft: 5 },
  'pino-tronzano': { fromRight: 8 },
};
function labelXFor(id: string, side: LabelSide): number {
  const override = LABEL_POSITION_OVERRIDES[id];
  if (override) return 'fromLeft' in override ? override.fromLeft : 100 - override.fromRight;
  return side === 'left' ? GUTTER_LEFT_PCT : GUTTER_RIGHT_PCT;
}
function gutterStyle(id: string, side: LabelSide): string {
  const override = LABEL_POSITION_OVERRIDES[id];
  if (override) return 'fromLeft' in override ? `left: ${override.fromLeft}%;` : `right: ${override.fromRight}%;`;
  return side === 'left' ? `left: ${GUTTER_LEFT_PCT}%;` : `right: ${100 - GUTTER_RIGHT_PCT}%;`;
}
// Labels anchored from the right (edge gutter or a right-anchored override)
// grow leftward (items-end) so their text doesn't run off-canvas;
// left-anchored labels (edge gutter or a left-anchored override) grow
// rightward (items-start) instead.
function labelAlignClass(id: string, side: LabelSide): string {
  const override = LABEL_POSITION_OVERRIDES[id];
  if (override) return 'fromLeft' in override ? 'items-start' : 'items-end';
  return side === 'left' ? 'items-start' : 'items-end';
}

// Multiple stations can sit close together vertically on the same gutter
// side (e.g. Baveno/Belgirate/Meina/Arona, all on the west shore, packed
// into a ~35% vertical band) — placing every label at exactly its icon's
// row, as before, made them overlap. Spread same-side labels apart to a
// minimum gap, preserving order, then re-center the adjusted run on the
// original cluster's midpoint so it doesn't just drift toward one edge.
// The label's own vertical position moves; the icon never does — the
// connector line (see connectorStyle below) is what keeps the moved label
// visually tied back to its real icon, drawn as a diagonal when the two no
// longer share a row.
const MIN_LABEL_GAP_PCT = 13;
const LABEL_BAND_MIN_PCT = 6;
const LABEL_BAND_MAX_PCT = 94;
function spreadLabelTops(items: { id: string; top: number }[]): Map<string, number> {
  const sorted = [...items].sort((a, b) => a.top - b.top);
  const adjusted = sorted.map((s) => s.top);
  for (let i = 1; i < adjusted.length; i++) {
    adjusted[i] = Math.max(adjusted[i], adjusted[i - 1] + MIN_LABEL_GAP_PCT);
  }
  if (adjusted.length > 0) {
    const naturalMid = (sorted[0].top + sorted[sorted.length - 1].top) / 2;
    const adjustedMid = (adjusted[0] + adjusted[adjusted.length - 1]) / 2;
    const shift = naturalMid - adjustedMid;
    for (let i = 0; i < adjusted.length; i++) adjusted[i] += shift;
    // Keep the whole run on-canvas even if re-centering pushed an edge past it.
    if (adjusted[0] < LABEL_BAND_MIN_PCT) {
      const delta = LABEL_BAND_MIN_PCT - adjusted[0];
      for (let i = 0; i < adjusted.length; i++) adjusted[i] += delta;
    }
    if (adjusted[adjusted.length - 1] > LABEL_BAND_MAX_PCT) {
      const delta = adjusted[adjusted.length - 1] - LABEL_BAND_MAX_PCT;
      for (let i = 0; i < adjusted.length; i++) adjusted[i] -= delta;
    }
  }
  const result = new Map<string, number>();
  sorted.forEach((s, i) => result.set(s.id, adjusted[i]));
  return result;
}

// The map's aspect-ratio-locked container (below) is 885:1406 — same ratio
// as the lake SVG's own viewBox, deliberately undistorted (1 unit is the
// same real distance on both axes). A 1%-of-width step and a 1%-of-height
// step therefore do NOT correspond to the same real distance — converting
// through these first is what makes the connector line's computed angle
// and length geometrically correct instead of skewed toward whichever axis
// the container happens to be longer on.
const ASPECT_W = 885;
const ASPECT_H = 1406;
function connectorStyle(
  iconPosition: { top: string; left: string },
  labelTopPct: number,
  labelXPct: number,
  opacity = 0.28
): string {
  const x1 = parseFloat(iconPosition.left);
  const y1 = parseFloat(iconPosition.top);
  const x2 = labelXPct;
  const y2 = labelTopPct;

  const dxUnits = ((x2 - x1) / 100) * ASPECT_W;
  const dyUnits = ((y2 - y1) / 100) * ASPECT_H;
  const lengthUnits = Math.hypot(dxUnits, dyUnits);
  const widthPct = (lengthUnits / ASPECT_W) * 100;
  const angleDeg = Math.atan2(dyUnits, dxUnits) * (180 / Math.PI);

  // Transparent at the icon (start), solid at the label (end) — draws the
  // eye toward the readable text rather than reading as a flat wire laid
  // over the map. Works at any angle since the div itself is what rotates;
  // the gradient direction ("to right") rotates along with its own box.
  return `top: ${y1}%; left: ${x1}%; width: ${widthPct}%; transform-origin: 0 50%; transform: rotate(${angleDeg}deg); background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,${opacity}));`;
}

// Station markers, two data sources:
// - 'ocr' stations: OCR runs client-side (see the <script> below — the WASM
//   OCR engine was too slow under Vercel's serverless CPU allocation to run
//   server-side reliably, see git history). The server only computes
//   position/name and renders a placeholder; the client script fetches+OCRs
//   the ticker image and upgrades the placeholder to a live marker in place.
// - 'json' stations (Meteo Live VCO network): a real JSON API, resolved
//   server-side like Föhn — no OCR, no client upgrade, renders live
//   immediately or falls back to a plain (non-pulsing — nothing will ever
//   retry it client-side) placeholder if the API's unreachable/stale.
// Both render through the same marker/label markup below, parametrized by
// whether `reading` is already known and whether it `needsClientUpgrade`.
interface StationSlot {
  id: string;
  name: string;
  position: { top: string; left: string };
  labelSide: LabelSide;
  attributionUrl: string;
  needsClientUpgrade: boolean;
  reading: {
    windKn: number;
    windDirDeg: number;
    pressureHpa: number;
    rainMm: number;
    lastModifiedLabel: string;
  } | null;
}

function formatLastUpdated(iso: string): string {
  const minutes = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (minutes < 60) return `agg. ${minutes}m fa`;
  return `agg. ${Math.round(minutes / 60)}h fa`;
}

const ocrStations = getActiveStations().filter((s) => s.dataType === 'ocr');
const jsonStations = getActiveStations().filter((s) => s.dataType === 'json');
const webcamStations = getActiveStations().filter((s) => s.dataType === 'photo');

// JSON stations, webcams and Föhn are all independent of each other and of
// the (now client-side) station OCR, so they're fetched concurrently — each
// is already timeout-bounded internally (see liveVcoStation.ts/webcams.ts/foehn.ts).
const [jsonResults, webcamResults, foehnStatus] = await Promise.all([
  Promise.all(
    jsonStations.map(async (station) => {
      const reading = await getLiveVcoReading(station.id, station.sourceId);
      return { station, reading };
    })
  ),
  Promise.all(
    // Webcam-only stations (e.g. Cannero): no wind reading, just a live
    // photo. Checked server-side (freshness-gated, same cache the proxy
    // endpoint hits) so we only render an <img> for sources we know will
    // actually resolve.
    webcamStations.map(async (station) => {
      const image = await getProxiedImage(station.id, station.sourceId);
      if (image.status !== 'fresh') return null;
      return { id: station.id, name: localizeStationName(station, locale), attributionUrl: station.attributionUrl };
    })
  ),
  getFoehnStatus(),
]);

const ocrSlots: StationSlot[] = ocrStations.map((station) => ({
  id: station.id,
  name: localizeStationName(station, locale).toUpperCase(),
  position: latLonToPosition(station.id, station.lat, station.lon),
  labelSide: labelSideFor(station.id),
  attributionUrl: station.attributionUrl,
  needsClientUpgrade: true,
  reading: null,
}));

const jsonSlots: StationSlot[] = jsonResults.map(({ station, reading }) => ({
  id: station.id,
  name: localizeStationName(station, locale).toUpperCase(),
  position: latLonToPosition(station.id, station.lat, station.lon),
  labelSide: labelSideFor(station.id),
  attributionUrl: station.attributionUrl,
  needsClientUpgrade: false,
  reading: reading
    ? {
        windKn: reading.windKn,
        windDirDeg: reading.windDirDeg,
        pressureHpa: reading.pressureHpa,
        rainMm: reading.rainMm,
        lastModifiedLabel: formatLastUpdated(reading.lastModified),
      }
    : null,
}));

const stationSlots: StationSlot[] = [...ocrSlots, ...jsonSlots];

// Label vertical positions, decluttered per gutter side — see
// spreadLabelTops above. Icons keep their real (possibly close-together)
// positions; only where the LABEL renders is adjusted.
const leftLabelTops = spreadLabelTops(
  stationSlots.filter((s) => s.labelSide === 'left').map((s) => ({ id: s.id, top: parseFloat(s.position.top) }))
);
const rightLabelTops = spreadLabelTops([
  ...stationSlots.filter((s) => s.labelSide === 'right').map((s) => ({ id: s.id, top: parseFloat(s.position.top) })),
  { id: 'calde', top: parseFloat(CALDE_POSITION.top) },
]);
function labelTopFor(id: string, side: LabelSide): number {
  const top = (side === 'left' ? leftLabelTops : rightLabelTops).get(id);
  if (top === undefined) throw new Error(`labelTopFor: no computed label top for station "${id}"`);
  return top;
}
const CALDE_LABEL_TOP = labelTopFor('calde', CALDE_LABEL_SIDE);

const liveWebcams = webcamResults.filter((w): w is NonNullable<typeof w> => w !== null);

// Translations are now passed as props from MeteoTemplate
---

<!-- Full viewport hero -->
<div class="lake-wind-hero h-[calc(100svh-4rem-4rem)] md:h-[calc(100svh-5rem)] md:min-h-[850px] flex flex-col relative z-10 shadow-[0_10px_40px_-5px_rgba(0,0,0,0.5)]">

  <!-- Map Section -->
  <section
    class="tactical-bg relative flex-1 min-h-0 overflow-hidden flex items-center justify-center"
    role="region"
    aria-label={t.ariaLabel}
  >
    
    <!-- Tactical Grid Overlay -->
    <div class="tactical-grid absolute inset-0 opacity-[0.03] pointer-events-none"></div>
    
    <!-- Aspect Ratio Locked Container -->
    <div class="relative mx-auto w-full max-w-[400px] aspect-[885/1406]">
      
      <!-- SVG Map -->
      <!-- viewBox padded 15% on every side (ZOOM_OUT_MARGIN_PCT above) so
           markers near the frame edges (e.g. Meina, Pino Tronzano) have
           breathing room instead of sitting flush against the hero's
           weather-widget/scroll-hint overlays. Keep in sync with that
           constant if either changes. -->
      <svg
        viewBox="-132.8 -210.9 1150.5 1827.8"
        xmlns="http://www.w3.org/2000/svg"
        class="lake-svg absolute inset-0 w-full h-full"
        fill="none"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label={t.mapAlt}
      >
        <defs>
          <filter id="lakeGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="8" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
          <linearGradient id="lakeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:rgba(6,182,212,0.15)"/>
            <stop offset="50%" style="stop-color:rgba(14,165,233,0.1)"/>
            <stop offset="100%" style="stop-color:rgba(6,182,212,0.2)"/>
          </linearGradient>
        </defs>

        <!-- Rivers -->
        <g stroke="rgba(34,211,238,0.3)" stroke-width="1.5" fill="none">
          <path d="M 3,731 L 22,747 L 68,754 L 75,735 L 95,729 L 111,743" />
          <path d="M 377,1324 L 412,1320 L 441,1361 L 422,1406" />
          <path d="M 572,567 L 581,577 L 592,583 L 623,584 L 643,584 L 657,581 L 667,582 L 670,575 L 677,577 L 670,589 L 686,599 L 695,588 L 718,587 L 723,586" />
          <path d="M 243,399 L 251,385 L 259,377 L 292,379 C 292,379 299,371 304,371 C 309,371 328,371 328,371 L 354,382 L 441,385 L 446,402 L 472,406 L 490,400 L 490,391 L 486,382 L 498,376" />
          <path d="M 568,451 L 620,430 L 670,410 L 681,394 L 696,392 L 741,342 L 742,320" />
          <path d="M 579,2 L 577,12 L 595,23 L 606,39 L 606,57 L 612,68 L 631,89 L 658,114 L 689,138 L 699,141" />
          <path d="M 791,2 L 774,42 L 808,73 L 803,89" />
          <path d="M 817,129 L 851,125 L 883,114" />
        </g>

        <!-- Lakes -->
        <g filter="url(#lakeGlow)">
          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.5)" stroke-width="1.5" d="M 525,1012 L 528,1021 L 552,1043 L 549,1056 L 545,1064 L 548,1073 L 550,1082 L 547,1093 L 545,1100 L 544,1112 L 555,1116 L 567,1114 L 582,1110 L 590,1106 L 590,1101 L 616,1105 L 622,1115 L 646,1126 L 661,1131 L 704,1116 L 711,1108 L 707,1102 L 696,1098 L 689,1106 L 676,1104 L 661,1090 L 649,1091 L 633,1082 L 632,1070 L 628,1060 L 616,1054 L 603,1052 L 594,1048 L 588,1040 L 588,1032 L 569,1014 L 567,1003 L 551,1004 L 537,1006 L 525,1012 z" />
          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.5)" stroke-width="1.5" d="M 482,1222 L 499,1192 L 495,1176 L 509,1167 L 517,1171 L 525,1199 L 519,1223 L 495,1252 L 486,1250 L 483,1245 L 482,1222 z" />
          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.5)" stroke-width="1.5" d="M 418,1119 L 422,1107 L 436,1101 L 459,1108 L 467,1122 L 478,1147 L 477,1153 L 470,1156 L 446,1132 L 429,1132 L 418,1119 z" />
          <path fill="url(#lakeGradient)" stroke="rgba(6,182,212,0.5)" stroke-width="1.5" d="M 33,678 L 33,684 L 58,709 L 69,716 L 78,712 L 85,703 L 81,694 L 60,680 L 49,676 L 33,678 z" />
