---
import { generateGoogleCalendarUrl } from '../utils/ics';
import { getAvailableDocuments } from '../utils/eventDocuments';
import { formatEventDateDisplay } from '../utils/eventDates';
import regateContent from '../data/regate-content.json';
import type { Locale } from '../i18n';
import type { Event, LocalizedText } from '../types/event';
import type { DailyData } from '../utils/weather';
import DailyForecastCard from './DailyForecastCard.astro';

interface Props {
  event: Event;
  compact?: boolean;
  locale?: Locale;
  weatherDay?: DailyData;
  forecastLabel?: string;
}

const { event, compact = false, locale = 'it', weatherDay, forecastLabel } = Astro.props;

// Helper to get localized text with fallback to Italian
const getText = (field: LocalizedText | undefined): string => {
  if (!field) return '';
  return field[locale] || field.it || '';
};

const title = getText(event.title);
const subtitle = getText(event.subtitle);
const description = getText(event.description);

// Generate Google Calendar link
const calendarUrl = generateGoogleCalendarUrl({
  title,
  description,
  date: event.date,
  endDate: event.endDate,
  time: event.time,
  location: 'Circolo Nautico Caldè, Via Maggiore 18, 21010 Castelveccana (VA)',
});

// Type configuration
const typeConfig = {
  corso: {
    label: 'Corso',
    icon: '⛵',
    colorClass: 'bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)]',
    textClass: 'text-accent',
  },
  regata: {
    label: 'Regata',
    icon: '🏆',
    colorClass: 'bg-[var(--color-accent-secondary)] dark:bg-[var(--color-accent-secondary-dark)]',
    textClass: 'text-[var(--color-accent-secondary)] dark:text-[var(--color-accent-secondary-dark)]',
  },
  evento_sociale: {
    label: 'Evento',
    icon: '🥂',
    colorClass: 'bg-[var(--color-accent-tertiary)] dark:bg-[var(--color-accent-tertiary-dark)]',
    textClass: 'text-[var(--color-accent-tertiary)] dark:text-[var(--color-accent-tertiary-dark)]',
  },
};

const config = typeConfig[event.type as keyof typeof typeConfig] || typeConfig.evento_sociale;
const dateDisplay = formatEventDateDisplay(event.date, event.endDate, locale);
const availableDocs = getAvailableDocuments(
  event,
  locale,
  event.type === 'regata' ? regateContent.documents : undefined
);
---

<article class:list={[
  "bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-secondary-dark)] rounded-xl border border-muted overflow-hidden transition-shadow hover:shadow-lg",
  { "p-4": compact, "p-6": !compact }
]}>
  <div class="flex items-start gap-4">
    <!-- Date badge + schedule -->
    <div class="flex-shrink-0 text-center w-20">
      <div class:list={[
        "rounded-lg px-3 py-2",
        config.colorClass
      ]}>
        <span class="text-white text-lg" aria-hidden="true">{config.icon}</span>
      </div>
      <p class="mt-2 text-sm font-bold leading-tight">
        <time datetime={event.date}>{dateDisplay}</time>
      </p>
      {event.time && (
        <p class="mt-1 text-xs text-muted">{event.time}</p>
      )}
    </div>
    
    <!-- Content -->
    <div class="flex-1 min-w-0">
      <!-- Type Badge -->
      <span class:list={[
        "inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide",
        config.textClass
      ]}>
        {config.label}
      </span>
      
      <!-- Title -->
      <h3 class:list={[
        "font-bold text-[var(--color-text-primary)] dark:text-[var(--color-text-primary-dark)] mt-1",
        { "text-base": compact, "text-lg": !compact }
      ]}>
        {title}
      </h3>
      
      {subtitle && (
        <p class="text-sm text-muted">
          {subtitle}
        </p>
      )}
      
      {!compact && (
        <>
          <!-- Description -->
          <p class="text-sm text-muted mt-2">
            {description}
          </p>

          {weatherDay && (
            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
              <DailyForecastCard
                day={weatherDay}
                locale={locale}
                showDate={false}
                label={forecastLabel}
              />
            </div>
          )}
          
          <!-- Actions -->
          <div class="flex flex-wrap gap-2 mt-4">
            {event.registrationUrl && event.status === 'open' && (
              <a
                href={event.registrationUrl}
                class="inline-flex items-center px-4 py-2 bg-[var(--color-accent-secondary)] dark:bg-[var(--color-accent-secondary-dark)] text-white font-bold text-sm uppercase tracking-wide rounded-lg hover:opacity-90 transition-opacity touch-target"
              >
                Iscriviti
              </a>
            )}
            
            <!-- Add to Calendar -->
            <a
              href={calendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 px-3 py-2 border border-gray-300 dark:border-gray-600 text-sm rounded-lg hover:bg-[var(--color-bg-secondary)] dark:hover:bg-[var(--color-bg-accent-dark)] transition-colors touch-target"
              title="Aggiungi a Google Calendar"
            >
              📅 Salva in Agenda
            </a>
            
            {availableDocs.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {availableDocs.map((doc) => (
                  <a
                    href={doc.url}
                    class="inline-flex items-center px-3 py-2 border border-gray-300 dark:border-gray-600 text-sm rounded-lg hover:bg-[var(--color-bg-secondary)] dark:hover:bg-[var(--color-bg-accent-dark)] transition-colors touch-target"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    📄 {doc.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </>
      )}
    </div>
  </div>
</article>

