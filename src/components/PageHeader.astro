---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-[var(--color-accent-primary)] dark:bg-slate-900/95 backdrop-blur-md border-t border-white/20 dark:border-slate-700/50 py-6 md:py-8 relative z-10 shadow-[0_10px_40px_-5px_rgba(0,0,0,0.5)] dark:shadow-none">
  <div class="max-w-6xl mx-auto px-4 lg:px-6">
    <h1 class="text-2xl md:text-3xl font-black text-white">{title}</h1>
    {subtitle && (
      <p class="text-sm md:text-base text-white/70 dark:text-slate-400 mt-2 max-w-2xl">{subtitle}</p>
    )}
  </div>
</section>

