---
import { locales, localeNames, getLocaleFromUrl, getLocalizedPath, type Locale } from '../i18n';

const currentLocale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<div class="language-switcher relative">
  <button 
    class="lang-toggle flex items-center gap-1.5 px-2 py-1.5 rounded-md text-sm font-medium
           text-gray-700 dark:text-gray-200 
           hover:bg-gray-100 dark:hover:bg-gray-700
           transition-colors"
    aria-label="Seleziona lingua"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
    </svg>
    <span class="uppercase">{currentLocale}</span>
    <svg class="w-3 h-3 transition-transform lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  
  <div 
    class="lang-dropdown absolute right-0 top-full mt-1 py-1 bg-white dark:bg-gray-800 
           rounded-lg shadow-lg border border-gray-200 dark:border-gray-700
           opacity-0 invisible transform -translate-y-2
           transition-all duration-200 ease-out z-50 min-w-[120px]"
    role="menu"
  >
    {locales.map((locale) => (
      <a
        href={getLocalizedPath(currentPath, locale)}
        class:list={[
          "block px-4 py-2 text-sm transition-colors",
          locale === currentLocale 
            ? "bg-[var(--color-accent-primary)] text-white font-medium" 
            : "text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700"
        ]}
        role="menuitem"
        aria-current={locale === currentLocale ? "page" : undefined}
      >
        <span class="flex items-center gap-2">
          <span class="text-base">{locale === 'it' ? '🇮🇹' : locale === 'en' ? '🇬🇧' : '🇩🇪'}</span>
          <span>{localeNames[locale]}</span>
        </span>
      </a>
    ))}
  </div>
</div>

<script>
  // Initialize language switchers when DOM is ready
  function initLanguageSwitchers() {
    document.querySelectorAll('.language-switcher').forEach((switcher) => {
      // Skip if already initialized
      if (switcher.hasAttribute('data-initialized')) return;
      switcher.setAttribute('data-initialized', 'true');
      
      const toggle = switcher.querySelector('.lang-toggle') as HTMLButtonElement;
      const dropdown = switcher.querySelector('.lang-dropdown') as HTMLElement;
      const chevron = switcher.querySelector('.lang-chevron') as HTMLElement;
      
      if (!toggle || !dropdown || !chevron) return;
      
      let isOpen = false;
      
      function openDropdown() {
        isOpen = true;
        dropdown.classList.remove('opacity-0', 'invisible', '-translate-y-2');
        dropdown.classList.add('opacity-100', 'visible', 'translate-y-0');
        chevron.classList.add('rotate-180');
        toggle.setAttribute('aria-expanded', 'true');
      }
      
      function closeDropdown() {
        isOpen = false;
        dropdown.classList.add('opacity-0', 'invisible', '-translate-y-2');
        dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
        chevron.classList.remove('rotate-180');
        toggle.setAttribute('aria-expanded', 'false');
      }
      
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        if (isOpen) {
          closeDropdown();
        } else {
          openDropdown();
        }
      });
      
      // Close on click outside
      document.addEventListener('click', (e) => {
        if (isOpen && !switcher.contains(e.target as Node)) {
          closeDropdown();
        }
      });
      
      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) {
          closeDropdown();
          toggle.focus();
        }
      });
    });
  }
  
  // Run on DOM ready and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageSwitchers);
  } else {
    initLanguageSwitchers();
  }
  document.addEventListener('astro:page-load', initLanguageSwitchers);
</script>

