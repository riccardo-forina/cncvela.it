---
import type { Locale } from '../i18n';
import type { FoehnStatus } from '../utils/foehn';
import { getDayName } from '../utils/weather';

interface Props {
  status: FoehnStatus | null;
  locale: Locale;
  labels: {
    title: string;
    forecastTitle: string;
    forecastExplainer: string;
    bassa: string;
    moderata: string;
    alta: string;
    disclaimer: string;
  };
}

const { status, locale, labels } = Astro.props;

const LEVEL_STYLES = {
  bassa: { text: 'text-emerald-300', dot: 'bg-emerald-400' },
  moderata: { text: 'text-amber-300', dot: 'bg-amber-400' },
  alta: { text: 'text-red-300', dot: 'bg-red-400' },
} as const;

const style = status ? LEVEL_STYLES[status.level] : null;
const levelLabel = status ? labels[status.level] : '';
const trendIcon = status?.trend === 'up' ? '↑' : status?.trend === 'down' ? '↓' : '→';
---

{status && style && (
  <div class="flex flex-col gap-2 text-white/90">
    <p class="text-sm">
      <span class="font-semibold">{labels.title}:</span>{' '}
      <span class={`font-semibold ${style.text}`}>{levelLabel}</span>
      <span class="text-white/50 font-mono text-xs ml-1">
        ({status.differentialHpa > 0 ? '+' : ''}{status.differentialHpa} hPa {trendIcon})
      </span>
      <span class="text-white/50 block sm:inline sm:ml-1">{labels.disclaimer}</span>
    </p>

    {status.forecast.length > 1 && (
      <>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
          <span class="text-white/40 text-xs uppercase tracking-wide flex-shrink-0">{labels.forecastTitle}</span>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            {status.forecast.map((day, i) => {
              const dayStyle = LEVEL_STYLES[day.level];
              return (
                <span class:list={['flex items-center gap-1.5 text-xs', i > 0 && 'opacity-70']}>
                  <span class="text-white/50 font-medium">{getDayName(day.date, locale)}</span>
                  <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${dayStyle.dot}`}></span>
                  <span class={`font-mono ${dayStyle.text}`}>
                    {day.differentialHpa > 0 ? '+' : ''}{day.differentialHpa}
                  </span>
                </span>
              );
            })}
          </div>
        </div>
        <p class="text-white/40 text-xs">{labels.forecastExplainer}</p>
      </>
    )}
  </div>
)}
