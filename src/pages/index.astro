    animation: subtle-zoom 20s ease-in-out infinite alternate;
  }
  
  @keyframes subtle-zoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }
</style>

<script>
  // Lazy load Google Maps on click - with cookie consent check
  document.addEventListener('DOMContentLoaded', () => {
    const mapContainer = document.getElementById('map-container');
    if (mapContainer) {
      mapContainer.addEventListener('click', () => {
        // Check if user has given consent for analytics (which includes third-party cookies)
        const CookieConsent = (window as any).CookieConsent;
        if (CookieConsent && !CookieConsent.acceptedCategory('analytics')) {
          // Show cookie preferences modal
          CookieConsent.showPreferences();
          return;
        }
        
        // Load map if consent given or CookieConsent not yet loaded
        loadMap(mapContainer);
      });
    }
  });

  function loadMap(container: HTMLElement) {
    const mapSrc = container.dataset.mapSrc;
    if (mapSrc && !container.querySelector('iframe')) {
      container.innerHTML = `
        <iframe 
          src="${mapSrc}"
          class="absolute inset-0 w-full h-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mappa del Circolo Nautico Caldè"
        ></iframe>
      `;
      container.classList.remove('cursor-pointer', 'group');
    }
  }
</script>
