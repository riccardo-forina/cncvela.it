---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import gallery from '../data/gallery.json';
import board from '../data/board.json';

const { contact } = board;

// Import images
import giovaneVelista from '../assets/images/corsi/giovane-velista.jpg';
import scuolaVelaAzione from '../assets/images/corsi/scuola-vela-azione.jpg';
import corsoCabinati from '../assets/images/corsi/corso-cabinati.jpg';
import tramontoLago from '../assets/images/atmosfera/tramonto-lago.jpg';

// Import all images dynamically for gallery preview optimization
const allImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.{jpg,jpeg,png}',
  { eager: true }
);

// Helper to get optimized image from public path
function getOptimizedImage(publicPath: string): ImageMetadata | undefined {
  const assetPath = `../assets/${publicPath}`;
  const module = allImageModules[assetPath];
  return module?.default;
}

// Get a selection of photos for the preview
const previewPhotos = [
  ...gallery.corsi.slice(0, 2),
  ...gallery.galleria.filter(img => img.src.includes('gruppo')).slice(0, 1),
  ...gallery.regate.slice(0, 1),
];

// Base URL for public assets
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videoPathDesktop = `${base}/videos/desktop/hero-homepage-loop`;
const videoPathMobile = `${base}/videos/mobile/hero-homepage-loop`;
const fallbackImagePath = `${base}/images/hero/hero-loop-fallback.jpg`;
---

<BaseLayout title="Scuola Vela FIV sul Lago Maggiore" description="Circolo Nautico Caldè - Scuola Vela FIV e Regate sul Lago Maggiore dal 1970. Corsi di vela per giovani e adulti a Castelveccana." image="images/hero/calde-aerial.jpg">
  
  <!-- HERO + STATS: Full viewport wrapper (account for header + bottom nav) -->
  <div class="h-[calc(100svh-4rem)] md:h-[calc(100svh-5rem)] flex flex-col pb-16 md:pb-0">
    
    <!-- HERO VIDEO with floating card -->
    <section class="hero-section relative flex-1 min-h-0 overflow-hidden flex items-end">
      <!-- Video background with fallback image -->
      <video
        id="hero-video"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover object-bottom"
        aria-label="Vista aerea della baia di Caldè sul Lago Maggiore"
        poster={fallbackImagePath}
      >
        <!-- Source will be set by JavaScript based on device -->
        <source id="video-source-mp4" src="" type="video/mp4" />
      </video>
      <!-- Fallback image shown when video fails to load or play -->
      <img
        id="hero-fallback"
        src={fallbackImagePath}
        alt="Vista aerea della baia di Caldè sul Lago Maggiore"
        class="absolute inset-0 w-full h-full object-cover object-bottom z-[-1] transition-opacity duration-500"
      />
      
      <!-- Play button overlay for iOS/mobile when autoplay is blocked -->
      <div
        id="hero-play-overlay"
        class="absolute inset-0 z-10 flex items-center justify-center bg-black/20 backdrop-blur-sm transition-opacity duration-500 cursor-pointer opacity-0 pointer-events-none"
        aria-label="Riproduci video"
      >
        <button
          id="hero-play-button"
          class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/90 hover:bg-white flex items-center justify-center shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="Riproduci video"
        >
          <svg class="w-8 h-8 md:w-10 md:h-10 text-[var(--color-accent-primary)] ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
    </div>
    
      <script define:vars={{ videoPathDesktop, videoPathMobile }}>
        // Select correct video source based on device and handle iOS Safari autoplay
        document.addEventListener('DOMContentLoaded', () => {
          const video = document.getElementById('hero-video');
          const sourceMp4 = document.getElementById('video-source-mp4');
          const fallback = document.getElementById('hero-fallback');
          const playOverlay = document.getElementById('hero-play-overlay');
          const playButton = document.getElementById('hero-play-button');
          
          if (!video || !sourceMp4 || !fallback || !playOverlay || !playButton) return;
          
          const isMobile = window.innerWidth < 768;
          
          // Show fallback initially, hide when video starts playing
          fallback.style.zIndex = '0';
          video.style.zIndex = '1';
          
          // Hide fallback and overlay when video starts playing
          const hideFallback = () => {
            fallback.style.zIndex = '-1';
            fallback.style.opacity = '0';
            playOverlay.style.opacity = '0';
            playOverlay.style.pointerEvents = 'none';
          };
          
          // Show fallback if video fails
          const showFallback = () => {
            fallback.style.zIndex = '0';
            fallback.style.opacity = '1';
            playOverlay.style.opacity = '1';
            playOverlay.style.pointerEvents = 'auto';
          };
          
          // Set source based on device
          const mp4Src = isMobile
            ? `${videoPathMobile}.mp4`
            : `${videoPathDesktop}.mp4`;
          
          // Set MP4 source
          sourceMp4.src = mp4Src;
          
          console.log('Video setup:', { isMobile, mp4Src });
          
          // Verify source is set
          console.log('Source set:', { mp4: sourceMp4.src });
          
          // Function to play video
          const playVideo = async () => {
            if (video.paused) {
              try {
                await video.play();
                hideFallback();
                return true;
              } catch (error) {
                // Autoplay blocked - show play button
                playOverlay.style.opacity = '1';
                playOverlay.style.pointerEvents = 'auto';
                return false;
              }
            }
            return true;
          };
          
          // Play button click handler
          const handlePlayClick = async (e) => {
            e.preventDefault();
            e.stopPropagation();
            console.log('Play button clicked, video readyState:', video.readyState);
            console.log('Video source:', sourceMp4.src);
            console.log('Video networkState:', video.networkState);
            console.log('Video error:', video.error);
            
            // Force reload if needed
            if (video.readyState < 2 || video.networkState === 3) {
              console.log('Reloading video...');
              video.load();
              // Wait for video to be ready
              await new Promise((resolve, reject) => {
                const timeout = setTimeout(() => {
                  reject(new Error('Video load timeout'));
                }, 5000);
                
                const onCanPlay = () => {
                  clearTimeout(timeout);
                  video.removeEventListener('canplay', onCanPlay);
                  video.removeEventListener('error', onError);
                  resolve();
                };
                
                const onError = () => {
                  clearTimeout(timeout);
                  video.removeEventListener('canplay', onCanPlay);
                  video.removeEventListener('error', onError);
                  reject(video.error);
                };
                
                video.addEventListener('canplay', onCanPlay);
                video.addEventListener('error', onError);
              }).catch((error) => {
                console.error('Video load failed:', error);
                showFallback();
                return;
              });
            }
            
            console.log('Attempting to play, readyState:', video.readyState);
            const played = await playVideo();
            if (played) {
              playOverlay.style.opacity = '0';
              playOverlay.style.pointerEvents = 'none';
            } else {
              console.error('Failed to play video');
            }
          };
          
          playButton.addEventListener('click', handlePlayClick);
          playOverlay.addEventListener('click', handlePlayClick);
          
          // Hide play button when video starts playing automatically
          const hidePlayButton = () => {
            playOverlay.style.opacity = '0';
            playOverlay.style.pointerEvents = 'none';
          };
          
          video.addEventListener('playing', () => {
            hideFallback();
            hidePlayButton();
          });
          video.addEventListener('error', showFallback);
          video.addEventListener('loadstart', () => {
            // Keep fallback visible until video actually plays
            fallback.style.zIndex = '0';
          });
          
          // Add comprehensive event listeners for debugging
          video.addEventListener('loadstart', () => {
            console.log('Video loadstart, readyState:', video.readyState);
          });
          
          video.addEventListener('loadedmetadata', () => {
            console.log('Video metadata loaded, readyState:', video.readyState);
          });
          
          video.addEventListener('loadeddata', () => {
            console.log('Video data loaded, readyState:', video.readyState);
          });
          
          video.addEventListener('progress', () => {
            console.log('Video progress, readyState:', video.readyState, 'buffered:', video.buffered.length);
          });
          
          video.addEventListener('canplay', () => {
            console.log('Video can play, readyState:', video.readyState);
            // Try to play immediately (works on most browsers)
            playVideo().then((played) => {
              // If autoplay failed, show play button
              if (!played) {
                playOverlay.style.opacity = '1';
                playOverlay.style.pointerEvents = 'auto';
              }
            });
          });
          
          video.addEventListener('canplaythrough', () => {
            console.log('Video can play through, readyState:', video.readyState);
          });
          
          video.addEventListener('error', (e) => {
            console.error('Video error:', e);
            console.error('Video error details:', video.error);
            console.error('Video error code:', video.error?.code, 'message:', video.error?.message);
            showFallback();
          });
          
          video.addEventListener('stalled', () => {
            console.warn('Video stalled');
          });
          
          video.addEventListener('suspend', () => {
            console.warn('Video suspended');
          });
          
          // Reload video to use correct source
          console.log('Calling video.load()');
          video.load();
          
          // Ensure video plays if paused (after user interaction)
          let hasUserInteracted = false;
          video.addEventListener('pause', () => {
            if (hasUserInteracted) {
              playVideo();
            }
          });
          
          // Track user interaction
          const markInteraction = () => {
            hasUserInteracted = true;
          };
          
          ['touchstart', 'click', 'scroll'].forEach(event => {
            document.addEventListener(event, markInteraction, { once: true, passive: true });
          });
          
          // Handle visibility changes
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && video.paused && hasUserInteracted) {
              playVideo();
            }
          });
        });
      </script>
      
      <script>
        // Ensure video loops properly on all devices
        document.addEventListener('DOMContentLoaded', () => {
          const video = document.getElementById('hero-video') as HTMLVideoElement;
          if (!video) return;
          
          // Ensure video plays if paused (some browsers pause autoplay videos)
          video.addEventListener('pause', () => {
            video.play().catch(() => {});
          });
          
          // Handle visibility changes (browser might pause when tab is not visible)
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && video.paused) {
              video.play().catch(() => {});
            }
          });
        });
      </script>
      
      <!-- Floating glass card - full on mobile, aligned right on desktop to show the lake -->
      <div class="relative z-10 w-full px-4 md:px-6 lg:px-8 pb-4 md:pb-6">
        <div class="max-w-6xl mx-auto flex justify-center md:justify-end">
          <div class="w-full md:w-[50%] lg:w-[40%] backdrop-blur-xl rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-2xl border border-white/15" style="background-color: rgba(30, 58, 95, 0.45);">
        <!-- Headline -->
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black leading-tight text-white">
              Vivi la Vela<br class="hidden md:inline" /><span class="text-[var(--color-accent-secondary)]"> sul Lago Maggiore</span>
        </h1>
            <p class="text-xs md:text-sm text-white/80 mt-1 md:mt-2">
              Associazione Sportiva dal 1965 · Passione per la vela
        </p>
            <!-- CTA -->
            <div class="mt-4 flex justify-center">
          <a
            href="circolo"
                class="inline-flex items-center gap-1.5 md:gap-2 px-4 md:px-6 py-2 md:py-3 bg-[var(--color-accent-secondary)] hover:bg-[var(--color-accent-secondary)]/90 text-[var(--color-accent-primary)] font-bold text-xs md:text-base rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
              >
                Unisciti a Noi
                <svg class="w-3.5 md:w-4 h-3.5 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
          </a>
        </div>
      </div>
    </div>
      </div>
    </section>
    
    <!-- Stats bar -->
    <section class="bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)] py-4 md:py-6 shrink-0">
      <div class="max-w-6xl mx-auto px-4 lg:px-6">
        <div class="grid grid-cols-3 text-center text-white divide-x divide-white/20">
          <div class="px-4 md:px-8">
            <div class="text-2xl md:text-3xl font-black text-[var(--color-accent-secondary)]">60</div>
            <div class="text-[10px] md:text-sm text-white/70 mt-0.5 md:mt-1">Anni di storia</div>
          </div>
          <div class="px-4 md:px-8">
            <div class="text-2xl md:text-3xl font-black text-[var(--color-accent-secondary)]">FIV</div>
            <div class="text-[10px] md:text-sm text-white/70 mt-0.5 md:mt-1">Affiliati dal 1975</div>
          </div>
          <div class="px-4 md:px-8">
            <div class="text-2xl md:text-3xl font-black text-[var(--color-accent-secondary)]">0-99</div>
            <div class="text-[10px] md:text-sm text-white/70 mt-0.5 md:mt-1">Soci di ogni età</div>
          </div>
        </div>
    </div>
  </section>
  </div>
  
  <!-- GALLERY PREVIEW -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black mb-4" style="font-size: var(--text-3xl);">
          La Vela a Caldè
          </h2>
        <p class="text-muted max-w-2xl mx-auto">
          Corsi per giovani e adulti, regate, e una comunità di appassionati sul Lago Maggiore
          </p>
        </div>
      
      <!-- Photo Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-8">
        {previewPhotos.map((img, idx) => {
          const optimizedImg = getOptimizedImage(img.src);
          return (
            <a 
              href="galleria" 
              class:list={[
                "group relative overflow-hidden rounded-2xl",
                idx === 0 ? "col-span-2 row-span-2 aspect-square" : "aspect-square"
              ]}
            >
              {optimizedImg ? (
                <Image 
                  src={optimizedImg}
                  alt={img.alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  widths={idx === 0 ? [400, 600, 800] : [200, 300, 400]}
                  sizes={idx === 0 ? "(max-width: 768px) 100vw, 50vw" : "(max-width: 768px) 50vw, 25vw"}
                  loading="lazy"
                />
              ) : (
                <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          );
        })}
      </div>
      
      <!-- Link to Gallery -->
      <div class="text-center">
        <a 
          href="galleria" 
          class="inline-flex items-center gap-2 text-[var(--color-accent-primary)] dark:text-[#7CB3F0] font-semibold hover:underline dark:hover:text-white"
        >
          Vedi tutte le foto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- CORSI: Cards with real content -->
  <section class="py-16 md:py-24 bg-secondary">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black mb-4" style="font-size: var(--text-3xl);">
          Corsi per i Soci
        </h2>
        <p class="text-muted max-w-2xl mx-auto">
          Scuola Vela riconosciuta FIV. Tre tipologie di corso per tutte le esigenze.
        </p>
      </div>
      
      <!-- Course Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Derive Settimanale -->
        <a href="corsi" class="group bg-white dark:bg-[var(--color-bg-primary-dark)] rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="relative h-48 overflow-hidden">
            <Image 
              src={giovaneVelista}
              alt="Corso derive settimanale"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
            <div class="absolute top-3 left-3 px-3 py-1 bg-[var(--color-accent-primary)] text-white text-xs font-bold rounded-full">
              5 GIORNI
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">
              Derive Settimanale
            </h3>
            <p class="text-muted text-sm mb-4">
              Corso intensivo dal lunedì al venerdì. Aperto a tutti, dai 6 ai 99 anni.
            </p>
            <span class="inline-flex items-center text-accent font-semibold text-sm">
              Scopri di più →
            </span>
          </div>
        </a>
        
        <!-- Derive Weekend -->
        <a href="corsi" class="group bg-white dark:bg-[var(--color-bg-primary-dark)] rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="relative h-48 overflow-hidden">
            <Image 
              src={scuolaVelaAzione}
              alt="Corso derive weekend"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
            <div class="absolute top-3 left-3 px-3 py-1 bg-[var(--color-accent-secondary)] text-[var(--color-accent-primary)] text-xs font-bold rounded-full">
              2 WEEKEND
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">
              Derive Weekend
            </h3>
            <p class="text-muted text-sm mb-4">
              Due fine settimana per chi non può frequentare il corso settimanale. Età 6-99.
            </p>
            <span class="inline-flex items-center text-accent font-semibold text-sm">
              Scopri di più →
            </span>
          </div>
        </a>
        
        <!-- Cabinati -->
        <a href="corsi" class="group bg-white dark:bg-[var(--color-bg-primary-dark)] rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="relative h-48 overflow-hidden">
            <Image 
              src={corsoCabinati}
              alt="Corso cabinati"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
            <div class="absolute top-3 left-3 px-3 py-1 bg-[var(--color-accent-tertiary)] text-white text-xs font-bold rounded-full">
              2 WEEKEND
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">
              Cabinati
            </h3>
            <p class="text-muted text-sm mb-4">
              Navigazione su barche più grandi. Date da concordare. Età 6-99.
            </p>
            <span class="inline-flex items-center text-accent font-semibold text-sm">
              Scopri di più →
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>
  
  <!-- LOCATION: Dove Siamo -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Map with lazy load -->
        <div 
          id="map-container"
          class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/3] cursor-pointer group"
          data-map-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1500!2d8.6618758!3d45.9459507!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4785d9ec50257fbf%3A0x8b25f1a1c3349f59!2sCircolo%20Nautico%20Cald%C3%A8!5e0!3m2!1sit!2sit!4v1"
        >
          <!-- Placeholder image -->
          <img 
            src={`${base}/images/map/placeholder.webp`}
            alt="Mappa del Circolo Nautico Caldè" 
            class="absolute inset-0 w-full h-full object-cover"
          />
          <!-- Click overlay -->
          <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/30 group-hover:bg-black/40 transition-colors">
            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-lg mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-[var(--color-accent-primary)]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <span class="text-white font-medium text-sm">Clicca per caricare la mappa</span>
          </div>
        </div>
        
        <!-- Info -->
        <div>
          <h2 class="text-3xl md:text-4xl font-black mb-6" style="font-size: var(--text-3xl);">
            Dove Siamo
          </h2>
          <p class="text-muted mb-8 leading-relaxed">
            Il Circolo Nautico Caldè si trova nella splendida baia di Caldè, frazione di Castelveccana, sulla sponda lombarda del Lago Maggiore. Una location unica, protetta dai venti e ideale per imparare a navigare.
          </p>
          
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-link-dark)]/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">Indirizzo</div>
                <div class="text-muted">{contact.address.street}, {contact.address.postalCode} {contact.address.city} ({contact.address.province})</div>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-link-dark)]/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
