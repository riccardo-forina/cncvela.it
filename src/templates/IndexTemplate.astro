---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import type { Locale } from '../i18n';

// Import data
import content from '../data/homepage-content.json';
import clubLife from '../data/club-life-config.json';
import instagramData from '../data/instagram-feed.json';
import contact from '../data/contact.json';

// Import images
import giovaneVelista from '../assets/images/corsi/giovane-velista.jpg';
import scuolaVelaAzione from '../assets/images/corsi/scuola-vela-azione.jpg';
import corsoCabinati from '../assets/images/corsi/corso-cabinati.jpg';
import tramontoLago from '../assets/images/atmosfera/tramonto-lago.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Helper to get localized text
const t = (obj: { it: string; en?: string; de?: string } | undefined, fallback = ''): string => {
  if (!obj) return fallback;
  return obj[locale] || obj.it || fallback;
};

// Base URL for public assets
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videoPathDesktop = `${base}/videos/desktop/hero-homepage-loop`;
const videoPathMobile = `${base}/videos/mobile/hero-homepage-loop`;
const fallbackImagePath = `${base}/images/hero/hero-loop-fallback.jpg`;

// Course images mapping
const courseImages = {
  settimanale: giovaneVelista,
  weekend: scuolaVelaAzione,
  cabinati: corsoCabinati,
};
---

<BaseLayout title={t(content.meta.title)} description={t(content.meta.description)} image="images/hero/calde-aerial.jpg" locale={locale}>
  
  <!-- HERO + STATS: Full viewport wrapper (account for header + bottom nav) -->
  <div class="h-[calc(100svh-4rem)] md:h-[calc(100svh-5rem)] flex flex-col pb-16 md:pb-0">
    
    <!-- HERO VIDEO with floating card -->
    <section class="hero-section relative flex-1 min-h-0 overflow-hidden flex items-end">
      <!-- Video background with fallback image -->
      <video
        id="hero-video"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover object-bottom"
        aria-label={t(content.hero.videoAria)}
        poster={fallbackImagePath}
      >
        <source id="video-source-mp4" src="" type="video/mp4" />
      </video>
      <!-- Fallback image -->
      <img
        id="hero-fallback"
        src={fallbackImagePath}
        alt={t(content.hero.videoAria)}
        class="absolute inset-0 w-full h-full object-cover object-bottom z-[-1] transition-opacity duration-500"
      />
      
      <!-- Play button overlay -->
      <div
        id="hero-play-overlay"
        class="absolute inset-0 z-10 flex items-center justify-center bg-black/20 backdrop-blur-sm transition-opacity duration-500 cursor-pointer opacity-0 pointer-events-none"
        aria-label={t(content.hero.playVideo)}
      >
        <button
          id="hero-play-button"
          class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/90 hover:bg-white flex items-center justify-center shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label={t(content.hero.playVideo)}
        >
          <svg class="w-8 h-8 md:w-10 md:h-10 text-[var(--color-accent-primary)] ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    
      <script define:vars={{ videoPathDesktop, videoPathMobile }}>
        document.addEventListener('DOMContentLoaded', () => {
          const video = document.getElementById('hero-video');
          const sourceMp4 = document.getElementById('video-source-mp4');
          const fallback = document.getElementById('hero-fallback');
          const playOverlay = document.getElementById('hero-play-overlay');
          const playButton = document.getElementById('hero-play-button');
          
          if (!video || !sourceMp4 || !fallback || !playOverlay || !playButton) return;
          
          const isMobile = window.innerWidth < 768;
          fallback.style.zIndex = '0';
          video.style.zIndex = '1';
          
          const hideFallback = () => {
            fallback.style.zIndex = '-1';
            fallback.style.opacity = '0';
            playOverlay.style.opacity = '0';
            playOverlay.style.pointerEvents = 'none';
          };
          
          const showFallback = () => {
            fallback.style.zIndex = '0';
            fallback.style.opacity = '1';
            playOverlay.style.opacity = '1';
            playOverlay.style.pointerEvents = 'auto';
          };
          
          const mp4Src = isMobile ? `${videoPathMobile}.mp4` : `${videoPathDesktop}.mp4`;
          sourceMp4.src = mp4Src;
          
          const playVideo = async () => {
            if (video.paused) {
              try {
                await video.play();
                hideFallback();
                return true;
              } catch (error) {
                playOverlay.style.opacity = '1';
                playOverlay.style.pointerEvents = 'auto';
                return false;
              }
            }
            return true;
          };
          
          const handlePlayClick = async (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (video.readyState < 2 || video.networkState === 3) {
              video.load();
              await new Promise((resolve, reject) => {
                const timeout = setTimeout(() => reject(new Error('Video load timeout')), 5000);
                const onCanPlay = () => { clearTimeout(timeout); video.removeEventListener('canplay', onCanPlay); resolve(); };
                const onError = () => { clearTimeout(timeout); video.removeEventListener('error', onError); reject(video.error); };
                video.addEventListener('canplay', onCanPlay);
                video.addEventListener('error', onError);
              }).catch(() => { showFallback(); return; });
            }
            const played = await playVideo();
            if (played) {
              playOverlay.style.opacity = '0';
              playOverlay.style.pointerEvents = 'none';
            }
          };
          
          playButton.addEventListener('click', handlePlayClick);
          playOverlay.addEventListener('click', handlePlayClick);
          
          video.addEventListener('playing', hideFallback);
          video.addEventListener('error', showFallback);
          video.addEventListener('canplay', () => { playVideo(); });
          
          video.load();
          
          let hasUserInteracted = false;
          video.addEventListener('pause', () => { if (hasUserInteracted) playVideo(); });
          ['touchstart', 'click', 'scroll'].forEach(event => {
            document.addEventListener(event, () => { hasUserInteracted = true; }, { once: true, passive: true });
          });
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && video.paused && hasUserInteracted) playVideo();
          });
        });
      </script>
      
      <!-- Floating glass card -->
      <div class="relative z-10 w-full px-4 md:px-6 lg:px-8 pb-4 md:pb-6">
        <div class="max-w-6xl mx-auto flex justify-center md:justify-end">
          <div class="w-full md:w-[55%] lg:w-[45%] backdrop-blur-xl rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-2xl border border-white/15" style="background-color: rgba(30, 58, 95, 0.45);">
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black leading-tight text-white">
              {t(content.hero.title)}<br /><span class="text-[var(--color-accent-secondary)]">{t(content.hero.titleAccent)}</span>
            </h1>
            <p class="text-xs md:text-sm text-white/80 mt-1 md:mt-2">
              {t(content.hero.subtitle)}
            </p>
            <div class="mt-4 flex justify-center">
              <a
                href="circolo"
                class="inline-flex items-center gap-1.5 md:gap-2 px-4 md:px-6 py-2 md:py-3 bg-[var(--color-accent-secondary)] hover:bg-[var(--color-accent-secondary)]/90 text-[var(--color-accent-primary)] font-bold text-xs md:text-base rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
              >
                {t(content.hero.cta)}
                <svg class="w-3.5 md:w-4 h-3.5 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Stats bar -->
    <section class="bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)] py-4 md:py-6 shrink-0">
      <div class="max-w-6xl mx-auto px-4 lg:px-6">
        <div class="grid grid-cols-3 text-center text-white divide-x divide-white/20">
          {content.stats.map((stat) => (
            <div class="px-4 md:px-8">
              <div class="text-2xl md:text-3xl font-black text-[var(--color-accent-secondary)]">{stat.value}</div>
              <div class="text-[10px] md:text-sm text-white/70 mt-0.5 md:mt-1">{t(stat.label)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
  
  <!-- VITA AL CIRCOLO: Events + Instagram -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black mb-4" style="font-size: var(--text-3xl);">
          {t(clubLife.title)}
        </h2>
        <p class="text-muted max-w-2xl mx-auto">
          {t(clubLife.subtitle)}
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Left: Upcoming Events (shown via JS if events within 60 days) -->
        <div>
          <UpcomingEvents locale={locale} maxEvents={2} startDate={clubLife.eventsStartDate} />
          
          <!-- Fallback when no events (always rendered, visible when events hidden) -->
          <div id="no-events-fallback" class="text-center py-8 px-4 bg-[var(--color-accent-primary)]/5 dark:bg-[var(--color-accent-primary-dark)]/10 rounded-2xl border border-[var(--color-accent-primary)]/20">
            <div class="w-16 h-16 mx-auto mb-4 bg-[var(--color-accent-primary)]/10 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-[var(--color-accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            </div>
            <h3 class="font-bold text-lg mb-2">{t(clubLife.offSeason.title)}</h3>
            <p class="text-muted text-sm mb-4">{t(clubLife.offSeason.description)}</p>
            <a 
              href="bacheca" 
              class="inline-flex items-center gap-2 text-[var(--color-accent-primary)] dark:text-[#7CB3F0] font-semibold text-sm hover:underline"
            >
              {t(clubLife.offSeason.cta)} →
            </a>
          </div>
        </div>
        
        <!-- Right: Instagram Feed (always visible) -->
        <div>
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold">{t(instagramData.title)}</h3>
          </div>
          <InstagramFeed locale={locale} />
        </div>
      </div>
      
      <!-- Gallery link (subtle) -->
      <div class="mt-12 text-center">
        <a 
          href="galleria" 
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-[var(--color-accent-primary)] dark:hover:text-[#7CB3F0] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {t(clubLife.galleryLink)}
        </a>
      </div>
    </div>
  </section>
  
  <script>
    // Hide fallback if events are shown
    document.addEventListener('DOMContentLoaded', () => {
      const eventsSection = document.getElementById('upcoming-events');
      const fallback = document.getElementById('no-events-fallback');
      
      if (eventsSection && fallback) {
        // Use MutationObserver to detect when events section becomes visible
        const observer = new MutationObserver(() => {
          if (!eventsSection.classList.contains('hidden')) {
            fallback.classList.add('hidden');
          }
        });
        
        observer.observe(eventsSection, { attributes: true, attributeFilter: ['class'] });
        
        // Also check immediately after a short delay (for JS execution order)
        setTimeout(() => {
          if (!eventsSection.classList.contains('hidden')) {
            fallback.classList.add('hidden');
          }
        }, 100);
      }
    });
  </script>
  
  <!-- CORSI -->
  <section class="py-16 md:py-24 bg-secondary">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black mb-4" style="font-size: var(--text-3xl);">
          {t(content.courses.title)}
        </h2>
        <p class="text-muted max-w-2xl mx-auto">
          {t(content.courses.subtitle)}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {content.courses.items.map((course, idx) => (
          <a href="corsi" class="group bg-white dark:bg-[var(--color-bg-primary-dark)] rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <div class="relative h-48 overflow-hidden">
              <Image 
                src={courseImages[course.id as keyof typeof courseImages]}
                alt={t(course.title)}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                widths={[320, 480, 640]}
                sizes="(max-width: 768px) 100vw, 33vw"
              />
              <div class:list={[
                "absolute top-3 left-3 px-3 py-1 text-xs font-bold rounded-full",
                idx === 0 ? "bg-[var(--color-accent-primary)] text-white" :
                idx === 1 ? "bg-[var(--color-accent-secondary)] text-[var(--color-accent-primary)]" :
                "bg-[var(--color-accent-tertiary)] text-white"
              ]}>
                {t(course.badge)}
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">
                {t(course.title)}
              </h3>
              <p class="text-muted text-sm mb-4">
                {t(course.description)}
              </p>
              <span class="inline-flex items-center text-accent font-semibold text-sm">
                {t(content.courses.learnMore)}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- LOCATION -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Map -->
        <MapEmbed 
          id="map-container-home"
          loadMapLabel={t(content.location.loadMap)}
          class="shadow-xl aspect-[4/3] rounded-2xl"
        />
        
        <!-- Info -->
        <div>
          <h2 class="text-3xl md:text-4xl font-black mb-6" style="font-size: var(--text-3xl);">
            {t(content.location.title)}
          </h2>
          <p class="text-muted mb-8 leading-relaxed">
            {t(content.location.description)}
          </p>
          
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-link-dark)]/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{t(content.location.addressLabel)}</div>
                <div class="text-muted">{contact.address.street}, {contact.address.postalCode} {contact.address.city} ({contact.address.province})</div>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-link-dark)]/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{t(content.location.phoneLabel)}</div>
                <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="text-[var(--color-accent-primary)] dark:text-[#7CB3F0] hover:underline dark:hover:text-white">{contact.phone}</a>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-link-dark)]/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{t(content.location.emailLabel)}</div>
                <a href={`mailto:${contact.email}`} class="text-[var(--color-accent-primary)] dark:text-[#7CB3F0] hover:underline dark:hover:text-white">{contact.email}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- FINAL CTA -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)]">
      <Image 
        src={tramontoLago}
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-overlay"
        widths={[640, 1024, 1536]}
        sizes="100vw"
        quality={70}
      />
    </div>
    
    <div class="relative z-10 max-w-3xl mx-auto px-4 lg:px-6 text-center text-white">
      <h2 class="text-3xl md:text-4xl font-black mb-6" style="font-size: var(--text-3xl);">
        {t(content.cta.title)}
      </h2>
      <p class="text-lg text-white/80 mb-10 max-w-xl mx-auto">
        {t(content.cta.description)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="circolo#diventa-socio"
          class="inline-flex items-center justify-center px-8 py-4 bg-[var(--color-accent-secondary)] text-[var(--color-accent-primary)] font-bold rounded-full hover:bg-[var(--color-accent-secondary)]/90 transition-colors"
        >
          {t(content.cta.primaryButton)}
        </a>
        <a
          href={`mailto:${contact.email}`}
          class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-bold rounded-full border-2 border-white/30 hover:bg-white/20 transition-colors"
        >
          {t(content.cta.secondaryButton)}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .hero-section img {
    animation: subtle-zoom 20s ease-in-out infinite alternate;
  }
  
  @keyframes subtle-zoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }
</style>


