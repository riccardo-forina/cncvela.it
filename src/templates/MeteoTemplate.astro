---
import BaseLayout from '../layouts/BaseLayout.astro';
import LakeWindMap from '../components/LakeWindMap.astro';
import type { Locale } from '../i18n';
import content from '../data/meteo-content.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Helper to get localized text
const t = (obj: { it: string; en?: string; de?: string } | string | undefined, fallback = ''): string => {
  if (!obj) return fallback;
  if (typeof obj === 'string') return obj;
  return obj[locale] || obj.it || fallback;
};

// Format hour based on locale (IT: 16, EN: 4 PM, DE: 16 Uhr)
const formatHour = (hour: number): string => {
  if (locale === 'en') {
    const period = hour >= 12 ? 'PM' : 'AM';
    const h12 = hour % 12 || 12;
    return `${h12}${period}`;
  }
  // IT and DE use 24h format
  return String(hour);
};

// Format date based on locale (IT: dd/mm, EN: mm/dd, DE: dd.mm)
const formatDate = (dateStr: string): string => {
  const parts = dateStr.split('-'); // YYYY-MM-DD
  const day = parts[2];
  const month = parts[1];
  
  if (locale === 'en') {
    return `${month}/${day}`; // MM/DD
  } else if (locale === 'de') {
    return `${day}.${month}`; // DD.MM
  }
  return `${day}/${month}`; // DD/MM (IT default)
};

// Caldè coordinates (CNC - Via Maggiore 36)
const LAT = 45.9448;
const LON = 8.6612;

// ============================================
// CACHE STRATEGY: 5 minute TTL
// ============================================
const CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutes

// Simple in-memory cache (works for SSR)
declare global {
  var weatherCache: { data: any; timestamp: number } | undefined;
}

// ============================================
// ONE-CALL API STRATEGY: Server-Side Fetch
// ============================================
interface HourlyData {
  time: string;
  hour: number;
  windSpeed: number;
  windDirection: number;
  isPast: boolean;
  isNow: boolean;
}

interface DailyData {
  date: string;
  dayName: string;
  weatherCode: number;
  weatherDesc: string;
  weatherIcon: string;
  tempMax: number;
  tempMin: number;
  windMax: number;
  windDirection: string;
}

interface CurrentData {
  windSpeed: number;
  windDirection: string;
  windDirectionDeg: number;
  temperature: number;
  humidity: number;
}

interface ForecastData {
  current: CurrentData;
  hourly: HourlyData[];
  daily: DailyData[];
  fetchTime: string;
}

// Wind direction to compass
function degToCompass(deg: number): string {
  const directions = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
  const index = Math.round(deg / 45) % 8;
  return directions[index];
}

// Weather code to description and icon
function getWeatherInfo(code: number) {
  const weatherMap: Record<number, { key: string; icon: string }> = {
    0: { key: 'clear', icon: '☀️' },
    1: { key: 'partlyCloudy', icon: '🌤️' },
    2: { key: 'partlyCloudy', icon: '⛅' },
    3: { key: 'cloudy', icon: '☁️' },
    45: { key: 'fog', icon: '🌫️' },
    48: { key: 'fog', icon: '🌫️' },
    51: { key: 'drizzle', icon: '🌧️' },
    53: { key: 'drizzle', icon: '🌧️' },
    55: { key: 'drizzle', icon: '🌧️' },
    61: { key: 'lightRain', icon: '🌧️' },
    63: { key: 'rain', icon: '🌧️' },
    65: { key: 'heavyRain', icon: '🌧️' },
    71: { key: 'snow', icon: '🌨️' },
    73: { key: 'snow', icon: '🌨️' },
    75: { key: 'snow', icon: '🌨️' },
    80: { key: 'showers', icon: '🌦️' },
    81: { key: 'showers', icon: '🌦️' },
    82: { key: 'showers', icon: '🌦️' },
    95: { key: 'thunderstorm', icon: '⛈️' },
    96: { key: 'thunderstorm', icon: '⛈️' },
    99: { key: 'thunderstorm', icon: '⛈️' },
  };
  
  const info = weatherMap[code] || { key: 'clear', icon: '❓' };
  const weatherContent = content.weather as Record<string, { it: string; en?: string; de?: string }>;
  const desc = weatherContent[info.key] ? t(weatherContent[info.key]) : 'N/A';
  return { desc, icon: info.icon };
}

// Format day name
function getDayName(dateStr: string, loc: Locale): string {
  const date = new Date(dateStr);
  const today = new Date();
  const tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);
  
  if (date.toDateString() === today.toDateString()) return t(content.days.today);
  if (date.toDateString() === tomorrow.toDateString()) return t(content.days.tomorrow);
  
  return date.toLocaleDateString(loc === 'de' ? 'de-DE' : loc === 'en' ? 'en-US' : 'it-IT', { 
    weekday: 'short', 
    day: 'numeric' 
  });
}

// Get wind color class based on knots (matching map's 5-level system)
function getWindColorClass(speed: number): { bg: string; text: string; bar: string; border: string; glow: string } {
  if (speed < 3) {
    // Principianti - sky/cyan
    return { bg: 'bg-sky-400/10', text: 'text-sky-400', bar: 'bg-sky-400', border: 'border-sky-400/40', glow: 'rgba(56, 189, 248, 0.3)' };
  } else if (speed < 7) {
    // Tutti - emerald
    return { bg: 'bg-emerald-400/10', text: 'text-emerald-400', bar: 'bg-emerald-400', border: 'border-emerald-400/40', glow: 'rgba(52, 211, 153, 0.3)' };
  } else if (speed < 11) {
    // Esperti - amber
    return { bg: 'bg-amber-400/10', text: 'text-amber-400', bar: 'bg-amber-400', border: 'border-amber-400/40', glow: 'rgba(251, 191, 36, 0.3)' };
  } else if (speed < 16) {
    // Attenzione - orange
    return { bg: 'bg-orange-400/10', text: 'text-orange-400', bar: 'bg-orange-400', border: 'border-orange-400/40', glow: 'rgba(251, 146, 60, 0.3)' };
  } else {
    // Sconsigliato - red
    return { bg: 'bg-red-400/10', text: 'text-red-400', bar: 'bg-red-400', border: 'border-red-400/40', glow: 'rgba(248, 113, 113, 0.3)' };
  }
}

// Get wind status and recommendation
// SERVER-SIDE API CALL - One request for all data (with 5-min cache)
let forecastData: ForecastData | null = null;
let fetchError = false;

// Check cache first (with validation for new data structure)
const now = Date.now();
const isCacheValid = globalThis.weatherCache && 
  (now - globalThis.weatherCache.timestamp) < CACHE_TTL_MS &&
  globalThis.weatherCache.data?.hourly?.[0]?.hasOwnProperty('isPast'); // Check for new interface

if (isCacheValid && globalThis.weatherCache) {
  // Use cached data
  forecastData = globalThis.weatherCache.data;
} else {
  // Fetch fresh data
  try {
    const response = await fetch(
      `https://api.open-meteo.com/v1/forecast?` +
      `latitude=${LAT}&longitude=${LON}` +
      `&current=temperature_2m,relative_humidity_2m,wind_speed_10m,wind_direction_10m` +
      `&hourly=wind_speed_10m,wind_direction_10m` +
      `&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max,wind_direction_10m_dominant` +
      `&wind_speed_unit=kn` +
      `&timezone=Europe/Rome` +
      `&forecast_days=7`
    );
    
    if (!response.ok) throw new Error('Weather API fetch failed');
    
    const data = await response.json();
    
    // Process current data
    const currentTime = new Date();
    const currentHour = currentTime.getHours();
    const todayStr = currentTime.toISOString().split('T')[0];
    
    const currentData: CurrentData = {
      windSpeed: Math.round(data.current.wind_speed_10m),
      windDirection: degToCompass(data.current.wind_direction_10m),
      windDirectionDeg: data.current.wind_direction_10m,
      temperature: Math.round(data.current.temperature_2m),
      humidity: Math.round(data.current.relative_humidity_2m),
    };
    
    // Process hourly data: ALL 24 HOURS of today (fixed positions)
    const hourlyData: HourlyData[] = [];
    for (let targetHour = 0; targetHour < 24; targetHour++) {
      // Find the index in the API data for this hour today
      const targetTimeStr = `${todayStr}T${String(targetHour).padStart(2, '0')}`;
      const idx = data.hourly.time.findIndex((t: string) => t.startsWith(targetTimeStr));
      
      if (idx !== -1) {
        hourlyData.push({
          time: String(targetHour).padStart(2, '0') + ':00',
          hour: targetHour,
          windSpeed: Math.round(data.hourly.wind_speed_10m[idx]),
          windDirection: data.hourly.wind_direction_10m[idx],
          isPast: targetHour < currentHour,
          isNow: targetHour === currentHour,
        });
      } else {
        // If no data for this hour, add placeholder (shouldn't happen with fresh data)
        hourlyData.push({
          time: String(targetHour).padStart(2, '0') + ':00',
          hour: targetHour,
          windSpeed: 0,
          windDirection: 0,
          isPast: targetHour < currentHour,
          isNow: targetHour === currentHour,
        });
      }
    }
    
    // Process daily data (7 days - today + 6 future days)
    const dailyData: DailyData[] = data.daily.time.slice(0, 7).map((dateStr: string, i: number) => {
      const weatherInfo = getWeatherInfo(data.daily.weather_code[i]);
      return {
        date: dateStr,
        dayName: getDayName(dateStr, locale),
        weatherCode: data.daily.weather_code[i],
        weatherDesc: weatherInfo.desc,
        weatherIcon: weatherInfo.icon,
        tempMax: Math.round(data.daily.temperature_2m_max[i]),
        tempMin: Math.round(data.daily.temperature_2m_min[i]),
        windMax: Math.round(data.daily.wind_speed_10m_max[i]),
        windDirection: degToCompass(data.daily.wind_direction_10m_dominant[i]),
      };
    });
    
    forecastData = {
      current: currentData,
      hourly: hourlyData,
      daily: dailyData,
      fetchTime: new Date().toLocaleTimeString(locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-US' : 'it-IT', { 
        hour: '2-digit', 
        minute: '2-digit' 
      }),
    };
    
    // Store in cache
    globalThis.weatherCache = {
      data: forecastData,
      timestamp: Date.now(),
    };
    
  } catch (error) {
    console.error('Error fetching forecast data:', error);
    fetchError = true;
  }
}

// Pre-compute values for templates
// Wind status and colors are calculated inline where needed
const maxWindScale = 20; // Max knots for bar chart scaling

// Compass direction to degrees for arrow rotation
const dirMap: Record<string, number> = { 'N': 0, 'NE': 45, 'E': 90, 'SE': 135, 'S': 180, 'SW': 225, 'W': 270, 'NW': 315 };
---

<BaseLayout title={t(content.page.title)} description={t(content.page.description)} locale={locale}>
  <!-- Tactical Wind Map Hero (Full Viewport) -->
  <LakeWindMap 
    locale={locale} 
    todayWeather={forecastData?.daily?.[0] ? {
      icon: forecastData.daily[0].weatherIcon,
      tempMax: forecastData.daily[0].tempMax,
      tempMin: forecastData.daily[0].tempMin,
    } : undefined}
  />

  <!-- Tactical Instrument Dashboard -->
  <section class="tactical-dashboard bg-slate-200 dark:bg-slate-950 py-8 md:py-12">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 space-y-6">
      
      {fetchError ? (
        <!-- Error State -->
        <div class="cyber-panel p-8 text-center">
          <p class="text-red-400 font-mono">{t(content.forecast.error)}</p>
    </div>
      ) : forecastData && (
        <>
          <!-- HOURLY WIND CHART (24h Fixed) -->
          <div class="w-full p-4 rounded-xl border transition-colors duration-300 bg-white border-slate-200 shadow-sm dark:bg-slate-900 dark:border-slate-800 dark:shadow-none">
            
            <!-- Header -->
            <div class="flex justify-between items-end mb-4">
              <h3 class="font-bold text-base text-slate-800 dark:text-white">
                Vento oggi
              </h3>
              <span class="text-sm md:text-xs text-slate-400 font-mono">max 20kn</span>
              </div>

            <!-- Chart Area (24h scrollable) -->
            <div id="hourly-chart-scroll" class="relative w-full overflow-x-auto hide-scrollbar">

              <!-- Bars (24 hours fixed) -->
              <div class="flex items-end gap-1 z-10 relative" style="min-width: 720px;">
                {forecastData.hourly.map((hour) => {
                  // Calculate height percentage (0-100%)
                  const heightPct = Math.min(100, (hour.windSpeed / maxWindScale) * 100);
                  const rotateDeg = hour.windDirection + 180;
                  
                  // Color logic: past hours are gray, future hours colored by wind
                  let barColor = "bg-slate-300 dark:bg-slate-700"; // Default: gray for past
                  let textColor = "text-slate-400 dark:text-slate-600";
                  let arrowColor = "text-slate-300 dark:text-slate-600";
                  
                  if (!hour.isPast) {
                    textColor = "text-slate-700 dark:text-white";
                    arrowColor = "text-slate-500 dark:text-slate-400";
                    
                    // Wind-based color for future hours (matching map legend)
                    if (hour.windSpeed < 3) barColor = "bg-sky-400";        // Principianti
                    else if (hour.windSpeed < 7) barColor = "bg-emerald-400"; // Tutti
                    else if (hour.windSpeed < 11) barColor = "bg-amber-400";  // Esperti
                    else if (hour.windSpeed < 16) barColor = "bg-orange-400"; // Attenzione
                    else barColor = "bg-red-400";                            // Sconsigliato
                  }
                  
                  return (
                    <div 
                      class="flex flex-col items-center gap-1 flex-1 min-w-[48px] md:min-w-[28px] group cursor-default"
                      data-hour={hour.hour}
                      id={hour.isNow ? "current-hour-bar" : undefined}
                    >
                      <!-- Bar -->
                      <div class="w-full flex items-end h-72 rounded-t-sm relative transition-colors bg-slate-100 dark:bg-slate-800/30">
                        <div 
                          class={`w-full rounded-t-sm transition-all duration-300 ${barColor} ${hour.isPast ? 'opacity-50' : ''}`}
                          style={`height: ${heightPct}%; min-height: 2px;`}
                        ></div>
        </div>

                      <!-- Arrow + Speed + Time -->
                      <div class="flex flex-col items-center gap-0.5">
                        <svg 
                          class={`w-7 h-7 md:w-5 md:h-5 transition-colors ${arrowColor} ${hour.isPast ? 'opacity-40' : ''}`}
                          style={`transform: rotate(${rotateDeg}deg)`}
                          viewBox="0 0 36 36" 
                          fill="none"
                        >
                          <circle cx="18" cy="8" r="5" fill="transparent" stroke="currentColor" stroke-width="2.5"/>
                          <line x1="18" y1="13" x2="18" y2="30" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                          <path d="M18 30 L12 23 M18 30 L24 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class={`text-base font-mono font-medium transition-colors ${hour.isPast ? 'opacity-40' : ''} ${textColor}`}>
                          {hour.windSpeed}<span class="opacity-50 text-sm">kn</span>
                        </span>
                        <span class={`text-base font-mono font-bold transition-colors ${hour.isNow ? 'text-cyan-600 dark:text-cyan-400' : hour.isPast ? 'text-slate-400 opacity-50' : 'text-slate-600 dark:text-slate-300'}`}>
                          {formatHour(hour.hour)}
                        </span>
      </div>
    </div>
                  );
                })}
              </div>
        </div>
        
            <!-- Legend (matching map's 5-level system) -->
            <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-slate-200 dark:border-slate-700/50">
              <div class="flex items-center gap-4 flex-wrap">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">&lt;3 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">3-7 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">7-11 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">11-16 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">&gt;16 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                  <span class="text-sm text-slate-500">Passato</span>
          </div>
          </div>
          </div>
          </div>

          <!-- Weekly Forecast (Map Style) -->
          <div class="w-full">
            <h3 class="font-bold text-base flex items-center gap-2 text-slate-800 dark:text-white mb-4">
              <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Prossimi giorni
            </h3>
            
            <!-- Horizontal Row of Day Cards (Map Style - Arrow + Box) -->
            <div class="flex flex-wrap justify-between gap-y-4">
              {forecastData.daily.slice(1, 7).map((day, index, arr) => {
                const colors = getWindColorClass(day.windMax);
                const arrowRotation = (dirMap[day.windDirection] || 0) + 180;
                // Format date based on locale
                const dateFormatted = formatDate(day.date);
                const isLast = index === arr.length - 1;
                
                return (
                  <>
                    <div class="flex flex-col items-start gap-1.5">
                      <!-- Date -->
                      <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">
                        {dateFormatted}
                      </p>
                      
                      <!-- Box + Arrow (Map Style - box left, arrow right) -->
                      <div class="flex items-center gap-2">
                        <!-- Speed Box (glassmorphism like map) -->
                        <div 
                          class={`px-2.5 py-1.5 rounded-lg backdrop-blur-md font-mono font-black text-base leading-none 
                            bg-white/90 dark:bg-slate-900/85 
                            border ${colors.border}
                            shadow-sm dark:shadow-[0_0_15px_var(--glow-color)]`}
                          style={`--glow-color: ${colors.glow}`}
                        >
                          <span class={colors.text}>{day.windMax}</span>
                          <span class={`text-xs ml-0.5 font-bold opacity-60 ${colors.text}`}>kn</span>
        </div>
        
                        <!-- Arrow (exact map style: circle + line + double arrow) -->
                        <svg 
                          width="28" 
                          height="28" 
                          viewBox="0 0 36 36" 
                          fill="none" 
                          class={`${colors.text} drop-shadow-lg flex-shrink-0`}
                          style={`transform: rotate(${arrowRotation}deg)`}
                        >
                          <circle cx="18" cy="8" r="5" fill="transparent" stroke="currentColor" stroke-width="2.5"/>
                          <line x1="18" y1="13" x2="18" y2="30" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                          <path d="M18 30 L12 23 M18 30 L24 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
      </div>

                      <!-- Weather Icon + Temp -->
                      <div class="flex items-center gap-1.5 mt-1">
                        <span class="text-lg">{day.weatherIcon}</span>
                        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                          {day.tempMax}° / {day.tempMin}°
                        </span>
                      </div>
                    </div>
                    {!isLast && (
                      <div class="hidden md:block w-px h-12 bg-slate-300/50 dark:bg-slate-700/50 self-center"></div>
                    )}
                  </>
                );
              })}
        </div>
      </div>
        </>
      )}

    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     CYBER-NAUTICAL DESIGN SYSTEM
     ============================================ */
  
  .cyber-panel {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgb(203 213 225);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.05);
  }
  
  :global(.dark) .cyber-panel {
    background: rgba(15, 23, 42, 0.8);
    border-color: rgba(6, 182, 212, 0.2);
  }
  
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgb(241 245 249);
    border-bottom: 1px solid rgb(226 232 240);
  }
  
  :global(.dark) .panel-header {
    background: rgba(30, 41, 59, 0.5);
    border-bottom-color: rgba(6, 182, 212, 0.1);
  }
  
  .panel-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(71 85 105);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  :global(.dark) .panel-title {
    color: rgb(34 211 238);
  }
  
  .panel-title svg {
    color: rgb(8 145 178);
  }
  
  :global(.dark) .panel-title svg {
    color: rgb(6 182 212);
  }
  
  .stat-card {
    text-align: center;
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgb(241 245 249);
    border: 1px solid rgb(226 232 240);
  }
  
  :global(.dark) .stat-card {
    background: rgba(30, 41, 59, 0.4);
    border-color: rgba(51, 65, 85, 0.3);
  }
  
  .stat-value {
    font-size: 1.875rem;
    font-weight: 900;
  }
  
  @media (min-width: 768px) {
    .stat-value {
      font-size: 2.25rem;
    }
  }
  
  .stat-unit {
    font-size: 1rem;
    font-weight: 700;
    margin-left: 0.25rem;
    opacity: 0.6;
  }
  
  .stat-label {
    font-size: 0.75rem;
    color: rgb(100 116 139);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }
  
  /* Hide scrollbar but allow scroll */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Daily Row Hover */
  .daily-row {
    transition: all 0.2s ease;
  }
  
  .daily-row:hover {
    transform: translateX(4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  
  /* Wind Indicator Animation */
  .wind-indicator svg {
    transition: transform 0.3s ease;
  }
  
  .daily-row:hover .wind-indicator svg {
    transform: scale(1.1);
  }
</style>

<script>
  // Auto-scroll hourly chart to current hour on mobile
  document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('hourly-chart-scroll');
    const currentHourBar = document.getElementById('current-hour-bar');
    
    if (scrollContainer && currentHourBar) {
      // Scroll to position current hour near the left (with some padding)
      const scrollPosition = currentHourBar.offsetLeft - 20;
      
      // Smooth scroll on mobile, instant on desktop (desktop shows all anyway)
      scrollContainer.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });
    }
  });
</script>
