---
import BaseLayout from '../layouts/BaseLayout.astro';
import LakeWindMap from '../components/LakeWindMap.astro';
import type { Locale } from '../i18n';
import content from '../data/meteo-content.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Helper to get localized text
const t = (obj: { it: string; en?: string; de?: string } | string | undefined, fallback = ''): string => {
  if (!obj) return fallback;
  if (typeof obj === 'string') return obj;
  return obj[locale] || obj.it || fallback;
};

// Caldè coordinates (CNC - Via Maggiore 36)
const LAT = 45.9448;
const LON = 8.6612;

// Create translations object for JS
const translations = {
  windStatus: {
    calm: t(content.windStatus.calm),
    light: t(content.windStatus.light),
    moderate: t(content.windStatus.moderate),
    strong: t(content.windStatus.strong),
    veryStrong: t(content.windStatus.veryStrong),
  },
  recommendations: {
    calm: t(content.recommendations.calm),
    light: t(content.recommendations.light),
    moderate: t(content.recommendations.moderate),
    strong: t(content.recommendations.strong),
    veryStrong: t(content.recommendations.veryStrong),
  },
  days: {
    today: t(content.days.today),
    tomorrow: t(content.days.tomorrow),
  },
  weather: {
    clear: t(content.weather.clear),
    partlyCloudy: t(content.weather.partlyCloudy),
    cloudy: t(content.weather.cloudy),
    fog: t(content.weather.fog),
    drizzle: t(content.weather.drizzle),
    lightRain: t(content.weather.lightRain),
    rain: t(content.weather.rain),
    heavyRain: t(content.weather.heavyRain),
    snow: t(content.weather.snow),
    showers: t(content.weather.showers),
    thunderstorm: t(content.weather.thunderstorm),
  },
  updated: t(content.current.updated),
  error: t(content.forecast.error),
};
---

<BaseLayout title={t(content.page.title)} description={t(content.page.description)} locale={locale}>
  <!-- Tactical Wind Map Hero (Full Viewport) -->
  <LakeWindMap locale={locale} />

  <!-- Tactical Data Section -->
  <section class="tactical-data-section bg-slate-200 dark:bg-slate-950 py-8 md:py-12">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 space-y-6">
      
      <!-- Current Conditions Panel -->
      <div class="tactical-panel bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm rounded-xl border border-slate-300 dark:border-slate-800 overflow-hidden">
        
        <!-- Panel Header -->
        <div class="flex items-center justify-between px-5 py-3 bg-slate-100 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700/50">
          <h2 class="text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            {t(content.sailing.title)}
          </h2>
          <span class="text-[10px] font-mono text-slate-500" id="last-update">{t(content.current.updated)}: --</span>
        </div>
        
        <!-- Sailing Status Banner -->
        <div id="sailing-banner" class="mx-4 mt-4 rounded-lg p-4 text-center bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/30">
          <p class="text-xl md:text-2xl font-black text-slate-800 dark:text-white" id="wind-status">--</p>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            {t(content.sailing.recommendedFor)}: <span id="recommended-for" class="font-semibold text-slate-700 dark:text-slate-300">--</span>
          </p>
        </div>
        
        <!-- Weather Stats Grid -->
        <div id="current-weather" class="grid grid-cols-2 md:grid-cols-4 gap-3 p-4">
          <div class="stat-card text-center p-4 bg-slate-100 dark:bg-slate-800/40 rounded-lg border border-slate-200 dark:border-slate-700/30">
            <p class="text-3xl md:text-4xl font-black text-cyan-600 dark:text-cyan-400 font-mono">
              <span id="current-wind-speed">--</span><span class="text-base font-bold ml-1 text-cyan-600/70 dark:text-cyan-500/70">kn</span>
            </p>
            <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">{t(content.current.wind)}</p>
          </div>
          <div class="stat-card text-center p-4 bg-slate-100 dark:bg-slate-800/40 rounded-lg border border-slate-200 dark:border-slate-700/30">
            <p class="text-3xl md:text-4xl font-black text-emerald-600 dark:text-emerald-400 font-mono" id="current-wind-dir">--</p>
            <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">{t(content.current.direction)}</p>
          </div>
          <div class="stat-card text-center p-4 bg-slate-100 dark:bg-slate-800/40 rounded-lg border border-slate-200 dark:border-slate-700/30">
            <p class="text-3xl md:text-4xl font-black text-amber-600 dark:text-amber-400 font-mono">
              <span id="current-temp">--</span><span class="text-base font-bold ml-1 text-amber-600/70 dark:text-amber-500/70">°C</span>
            </p>
            <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">{t(content.current.temperature)}</p>
          </div>
          <div class="stat-card text-center p-4 bg-slate-100 dark:bg-slate-800/40 rounded-lg border border-slate-200 dark:border-slate-700/30">
            <p class="text-3xl md:text-4xl font-black text-sky-600 dark:text-sky-400 font-mono">
              <span id="current-humidity">--</span><span class="text-base font-bold ml-1 text-sky-600/70 dark:text-sky-500/70">%</span>
            </p>
            <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">{t(content.current.humidity)}</p>
          </div>
        </div>
      </div>

      <!-- Hourly Forecast Panel -->
      <div class="tactical-panel bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm rounded-xl border border-slate-300 dark:border-slate-800 overflow-hidden">
        
        <!-- Panel Header -->
        <div class="flex items-center justify-between px-5 py-3 bg-slate-100 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700/50">
          <h2 class="text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {t(content.forecast.hourly)}
          </h2>
        </div>
        
        <div class="p-4">
          <div id="hourly-forecast" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-12 gap-2">
            <p class="col-span-full text-slate-500 text-sm">{t(content.forecast.loading)}</p>
          </div>
          
          <p class="text-[10px] text-slate-600 mt-4 font-mono">
            {t(content.forecast.disclaimer)}
          </p>
        </div>
      </div>

      <!-- Daily Forecast Panel -->
      <div class="tactical-panel bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm rounded-xl border border-slate-300 dark:border-slate-800 overflow-hidden">
        
        <!-- Panel Header -->
        <div class="flex items-center justify-between px-5 py-3 bg-slate-100 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700/50">
          <h2 class="text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {t(content.forecast.daily)}
          </h2>
        </div>
        
        <div class="p-4">
          <div id="daily-forecast" class="space-y-2">
            <p class="text-slate-500 text-sm">{t(content.forecast.loading)}</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ LAT, LON, translations, locale }}>
  // Wind direction to compass
  function degToCompass(deg) {
    const directions = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
    const index = Math.round(deg / 45) % 8;
    return directions[index];
  }

  // Get wind status, recommendation, and color (thresholds in knots) - Light/Dark mode compatible
  function getWindConditions(speed) {
    if (speed < 3) {
      return { status: translations.windStatus.calm, recommendation: translations.recommendations.calm, bgClass: 'bg-sky-500/10', dotClass: 'bg-sky-500', textClass: 'text-sky-600 dark:text-sky-400' };
    } else if (speed < 7) {
      return { status: translations.windStatus.light, recommendation: translations.recommendations.light, bgClass: 'bg-emerald-500/10', dotClass: 'bg-emerald-500', textClass: 'text-emerald-600 dark:text-emerald-400' };
    } else if (speed < 11) {
      return { status: translations.windStatus.moderate, recommendation: translations.recommendations.moderate, bgClass: 'bg-amber-500/10', dotClass: 'bg-amber-500', textClass: 'text-amber-600 dark:text-amber-400' };
    } else if (speed < 16) {
      return { status: translations.windStatus.strong, recommendation: translations.recommendations.strong, bgClass: 'bg-orange-500/10', dotClass: 'bg-orange-500', textClass: 'text-orange-600 dark:text-orange-400' };
    } else {
      return { status: translations.windStatus.veryStrong, recommendation: translations.recommendations.veryStrong, bgClass: 'bg-red-500/10', dotClass: 'bg-red-500', textClass: 'text-red-600 dark:text-red-400' };
    }
  }

  // Weather code to description and icon
  function getWeatherInfo(code) {
    const weatherCodes = {
      0: { desc: translations.weather.clear, icon: '☀️' },
      1: { desc: translations.weather.partlyCloudy, icon: '🌤️' },
      2: { desc: translations.weather.partlyCloudy, icon: '⛅' },
      3: { desc: translations.weather.cloudy, icon: '☁️' },
      45: { desc: translations.weather.fog, icon: '🌫️' },
      48: { desc: translations.weather.fog, icon: '🌫️' },
      51: { desc: translations.weather.drizzle, icon: '🌧️' },
      53: { desc: translations.weather.drizzle, icon: '🌧️' },
      55: { desc: translations.weather.drizzle, icon: '🌧️' },
      61: { desc: translations.weather.lightRain, icon: '🌧️' },
      63: { desc: translations.weather.rain, icon: '🌧️' },
      65: { desc: translations.weather.heavyRain, icon: '🌧️' },
      71: { desc: translations.weather.snow, icon: '🌨️' },
      73: { desc: translations.weather.snow, icon: '🌨️' },
      75: { desc: translations.weather.snow, icon: '🌨️' },
      80: { desc: translations.weather.showers, icon: '🌦️' },
      81: { desc: translations.weather.showers, icon: '🌦️' },
      82: { desc: translations.weather.showers, icon: '🌦️' },
      95: { desc: translations.weather.thunderstorm, icon: '⛈️' },
      96: { desc: translations.weather.thunderstorm, icon: '⛈️' },
      99: { desc: translations.weather.thunderstorm, icon: '⛈️' },
    };
    return weatherCodes[code] || { desc: 'N/D', icon: '❓' };
  }

  // Format day name
  function getDayName(dateStr) {
    const date = new Date(dateStr);
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    
    if (date.toDateString() === today.toDateString()) return translations.days.today;
    if (date.toDateString() === tomorrow.toDateString()) return translations.days.tomorrow;
    
    return date.toLocaleDateString(locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-US' : 'it-IT', { weekday: 'short', day: 'numeric' });
  }

  async function fetchWeather() {
    try {
      const response = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,wind_direction_10m&hourly=wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max,wind_direction_10m_dominant&wind_speed_unit=kn&timezone=Europe/Rome&forecast_days=7`
      );
      
      if (!response.ok) throw new Error('Weather fetch failed');
      
      const data = await response.json();
      
      // Update current conditions
      const windSpeed = Math.round(data.current.wind_speed_10m);
      const windDir = degToCompass(data.current.wind_direction_10m);
      const temp = Math.round(data.current.temperature_2m);
      const humidity = Math.round(data.current.relative_humidity_2m);
      
      document.getElementById('current-wind-speed').textContent = windSpeed;
      document.getElementById('current-wind-dir').textContent = windDir;
      document.getElementById('current-temp').textContent = temp;
      document.getElementById('current-humidity').textContent = humidity;
      
      // Update timestamp
      const now = new Date();
      document.getElementById('last-update').textContent = 
        `${translations.updated}: ${now.toLocaleTimeString(locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-US' : 'it-IT', { hour: '2-digit', minute: '2-digit' })}`;
      
      // Update sailing conditions banner - Tactical Dark Theme
      const conditions = getWindConditions(windSpeed);
      const banner = document.getElementById('sailing-banner');
      const statusEl = document.getElementById('wind-status');
      statusEl.innerHTML = `<span class="inline-block w-3 h-3 rounded-full ${conditions.dotClass} mr-2 shadow-lg"></span><span class="${conditions.textClass}">${conditions.status}</span>`;
      document.getElementById('recommended-for').textContent = conditions.recommendation;
      
      // Update banner background color
      banner.className = `mx-4 mt-4 rounded-lg p-4 text-center border border-slate-200 dark:border-slate-700/30 ${conditions.bgClass}`;
      
      // Update hourly forecast
      const hourlyContainer = document.getElementById('hourly-forecast');
      const currentHour = new Date().getHours();
      
      let hourlyHTML = '';
      
      for (let i = currentHour; i < Math.min(currentHour + 12, 24); i++) {
        const hour = data.hourly.time[i].split('T')[1].substring(0, 5);
        const speed = Math.round(data.hourly.wind_speed_10m[i]);
        const dir = degToCompass(data.hourly.wind_direction_10m[i]);
        
        // Colors based on wind speed (knots) - light/dark mode compatible
        let bgColor = 'bg-sky-500/10 border-sky-500/30';
        let textColor = 'text-sky-600 dark:text-sky-400';
        if (speed >= 3 && speed < 7) { bgColor = 'bg-emerald-500/10 border-emerald-500/30'; textColor = 'text-emerald-600 dark:text-emerald-400'; }
        else if (speed >= 7 && speed < 11) { bgColor = 'bg-amber-500/10 border-amber-500/30'; textColor = 'text-amber-600 dark:text-amber-400'; }
        else if (speed >= 11 && speed < 16) { bgColor = 'bg-orange-500/10 border-orange-500/30'; textColor = 'text-orange-600 dark:text-orange-400'; }
        else if (speed >= 16) { bgColor = 'bg-red-500/10 border-red-500/30'; textColor = 'text-red-600 dark:text-red-400'; }
        
        hourlyHTML += `
          <div class="text-center p-2 rounded-lg border ${bgColor}">
            <p class="text-[10px] text-slate-600 dark:text-slate-500 font-mono">${hour}</p>
            <p class="text-base font-black font-mono ${textColor}">${speed}<span class="text-[10px] font-medium ml-0.5 opacity-60">kn</span></p>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">${dir}</p>
          </div>
        `;
      }
      
      hourlyContainer.innerHTML = hourlyHTML;
      
      // Update daily forecast
      const dailyContainer = document.getElementById('daily-forecast');
      let dailyHTML = '';
      
      for (let i = 0; i < data.daily.time.length; i++) {
        const day = getDayName(data.daily.time[i]);
        const weather = getWeatherInfo(data.daily.weather_code[i]);
        const tempMax = Math.round(data.daily.temperature_2m_max[i]);
        const tempMin = Math.round(data.daily.temperature_2m_min[i]);
        const windMax = Math.round(data.daily.wind_speed_10m_max[i]);
        const windDir = degToCompass(data.daily.wind_direction_10m_dominant[i]);
        const windConditions = getWindConditions(windMax);
        
        dailyHTML += `
          <div class="flex items-center justify-between p-3 rounded-lg border border-slate-200 dark:border-slate-700/30 ${windConditions.bgClass}">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-2xl">${weather.icon}</span>
              <div class="min-w-0">
                <p class="font-bold text-slate-700 dark:text-slate-200">${day}</p>
                <p class="text-xs text-slate-500 truncate">${weather.desc}</p>
              </div>
            </div>
            <div class="flex items-center gap-4 md:gap-6 text-right">
              <div>
                <p class="font-bold text-amber-600 dark:text-amber-400 font-mono">${tempMax}° <span class="font-normal text-slate-500">/ ${tempMin}°</span></p>
              </div>
              <div class="min-w-[60px]">
                <p class="font-black font-mono ${windConditions.textClass}">${windMax} <span class="text-xs opacity-60">kn</span></p>
                <p class="text-xs text-slate-500">${windDir}</p>
              </div>
            </div>
          </div>
        `;
      }
      
      dailyContainer.innerHTML = dailyHTML;
      
    } catch (error) {
      console.error('Weather fetch error:', error);
      document.getElementById('hourly-forecast').innerHTML = 
        `<p class="col-span-full text-red-500">${translations.error}</p>`;
      document.getElementById('daily-forecast').innerHTML = 
        `<p class="text-red-500">${translations.error}</p>`;
    }
  }
  
  // Fetch on load
  fetchWeather();
  
  // Refresh every 10 minutes
  setInterval(fetchWeather, 10 * 60 * 1000);
</script>



