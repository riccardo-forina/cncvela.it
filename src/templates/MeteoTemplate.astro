---
import BaseLayout from '../layouts/BaseLayout.astro';
import LakeWindMap from '../components/LakeWindMap.astro';
import DailyForecastCard from '../components/DailyForecastCard.astro';
import type { Locale } from '../i18n';
import content from '../data/meteo-content.json';
import { fetchForecast } from '../utils/weather';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Helper to get localized text
const t = (obj: { it: string; en?: string; de?: string; fr?: string } | string | undefined, fallback = ''): string => {
  if (!obj) return fallback;
  if (typeof obj === 'string') return obj;
  return obj[locale] || obj.it || fallback;
};

// Which locales use 12h clock display (IT/DE/FR: 16, EN: 4 PM).
const USES_12H_CLOCK: Record<Locale, boolean> = { it: false, en: true, de: false, fr: false };

const formatHour = (hour: number): string => {
  if (!USES_12H_CLOCK[locale]) return String(hour);
  const period = hour >= 12 ? 'PM' : 'AM';
  const h12 = hour % 12 || 12;
  return `${h12}${period}`;
};

const forecastData = await fetchForecast(locale);
const fetchError = !forecastData;

// Pre-compute values for templates
const maxWindScale = 20; // Max knots for bar chart scaling
---

<BaseLayout title={t(content.page.title)} description={t(content.page.description)} locale={locale}>
  <!-- Tactical Wind Map Hero (Full Viewport) -->
  <LakeWindMap 
    locale={locale} 
    translations={{
      title: t(content.map.title),
      seoTitle: t(content.map.seoTitle),
      ariaLabel: t(content.map.ariaLabel),
      mapAlt: t(content.map.mapAlt),
      scroll: t(content.map.scroll),
      disclaimer: t(content.map.disclaimer),
      sourceLabel: t(content.map.sourceLabel),
      stationsTitle: t(content.map.stationsTitle),
      webcamsTitle: t(content.map.webcamsTitle),
      foehn: {
        title: t(content.map.foehn.title),
        bassa: t(content.map.foehn.bassa),
        moderata: t(content.map.foehn.moderata),
        alta: t(content.map.foehn.alta),
        disclaimer: t(content.map.foehn.disclaimer),
      },
    }}
  />

  <!-- Tactical Instrument Dashboard. This is the last section on the page —
       BaseLayout's <main> reserves pb-20 (mobile only) below the slot so
       content isn't hidden under the fixed BottomNav, but that reserved
       space is main's own white background, not this section's, so it
       showed up as a stray white band between here and the Footer. Extend
       this section's own bottom padding by that same amount and cancel
       main's reservation with a matching negative margin, so the section's
       background (not white) fills the reserved space instead — the actual
       amount of safe non-content space above the Footer is unchanged. -->
  <section class="tactical-dashboard bg-slate-200 dark:bg-slate-950 py-8 pb-28 -mb-20 md:py-12 md:mb-0">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 space-y-6">

      <h2 class="text-xl md:text-2xl font-black text-slate-800 dark:text-white">
        {t(content.forecast.sectionTitle)}
      </h2>

      {fetchError ? (
        <!-- Error State -->
        <div class="cyber-panel p-8 text-center">
          <p class="text-red-400 font-mono">{t(content.forecast.error)}</p>
    </div>
      ) : forecastData && (
        <>
          <!-- HOURLY WIND CHART (24h Fixed) -->
          <div class="w-full p-4 rounded-xl border transition-colors duration-300 bg-white border-slate-200 shadow-sm dark:bg-slate-900 dark:border-slate-800 dark:shadow-none">
            
            <!-- Header -->
            <div class="flex justify-between items-end mb-4">
              <h2 class="font-bold text-base text-slate-800 dark:text-white">
                {t(content.forecast.hourly)}
              </h2>
              <span class="text-sm md:text-xs text-slate-400 font-mono">max 20kn</span>
              </div>

            <!-- Chart Area (24h scrollable) -->
            <div id="hourly-chart-scroll" class="relative w-full overflow-x-auto hide-scrollbar">

              <!-- Bars (24 hours fixed) -->
              <div class="flex items-end gap-1 z-10 relative" style="min-width: 720px;">
                {forecastData.hourly.map((hour) => {
                  // Calculate height percentage (0-100%)
                  const heightPct = Math.min(100, (hour.windSpeed / maxWindScale) * 100);
                  const rotateDeg = hour.windDirection + 180;
                  
                  // Color logic: past hours are gray, future hours colored by wind
                  let barColor = "bg-slate-300 dark:bg-slate-700"; // Default: gray for past
                  let textColor = "text-slate-400 dark:text-slate-600";
                  let arrowColor = "text-slate-300 dark:text-slate-600";
                  
                  if (!hour.isPast) {
                    textColor = "text-slate-700 dark:text-white";
                    arrowColor = "text-slate-500 dark:text-slate-400";
                    
                    // Wind-based color for future hours (matching map legend)
                    if (hour.windSpeed < 3) barColor = "bg-sky-400";        // Principianti
                    else if (hour.windSpeed < 7) barColor = "bg-emerald-400"; // Tutti
                    else if (hour.windSpeed < 11) barColor = "bg-yellow-400";  // Esperti
                    else if (hour.windSpeed < 16) barColor = "bg-orange-400"; // Attenzione
                    else barColor = "bg-red-400";                            // Sconsigliato
                  }
                  
                  return (
                    <div 
                      class="flex flex-col items-center gap-1 flex-1 min-w-[48px] md:min-w-[28px] group cursor-default"
                      data-hour={hour.hour}
                      id={hour.isNow ? "current-hour-bar" : undefined}
                    >
                      <!-- Bar -->
                      <div class="w-full flex items-end h-36 rounded-t-sm relative transition-colors bg-slate-100 dark:bg-slate-800/30">
                        <div 
                          class={`w-full rounded-t-sm transition-all duration-300 ${barColor} ${hour.isPast ? 'opacity-50' : ''}`}
                          style={`height: ${heightPct}%; min-height: 2px;`}
                        ></div>
        </div>

                      <!-- Arrow + Speed + Time -->
                      <div class="flex flex-col items-center gap-0.5">
                        <svg 
                          class={`w-7 h-7 md:w-5 md:h-5 transition-colors ${arrowColor} ${hour.isPast ? 'opacity-40' : ''}`}
                          style={`transform: rotate(${rotateDeg}deg)`}
                          viewBox="0 0 36 36" 
                          fill="none"
                        >
                          <circle cx="18" cy="8" r="5" fill="transparent" stroke="currentColor" stroke-width="2.5"/>
                          <line x1="18" y1="13" x2="18" y2="30" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                          <path d="M18 30 L12 23 M18 30 L24 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class={`text-base font-mono font-medium transition-colors ${hour.isPast ? 'opacity-40' : ''} ${textColor}`}>
                          {hour.windSpeed}<span class="opacity-50 text-sm">kn</span>
                        </span>
                        <span class={`text-base font-mono font-bold transition-colors ${hour.isNow ? 'text-cyan-600 dark:text-cyan-400' : hour.isPast ? 'text-slate-400 opacity-50' : 'text-slate-600 dark:text-slate-300'}`}>
                          {formatHour(hour.hour)}
                        </span>
      </div>
    </div>
                  );
                })}
              </div>
        </div>
        
            <!-- Legend (matching map's 5-level system) -->
            <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-slate-200 dark:border-slate-700/50">
              <div class="flex items-center gap-4 flex-wrap">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">&lt;3 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">3-7 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">7-11 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">11-16 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                  <span class="text-sm text-slate-600 dark:text-slate-400">&gt;16 kn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                  <span class="text-sm text-slate-500">{t(content.legend.past)}</span>
          </div>
          </div>
          </div>
          </div>

          <!-- Weekly Forecast (Map Style) -->
          <div class="w-full">
            <h2 class="font-bold text-base flex items-center gap-2 text-slate-800 dark:text-white mb-4">
              <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              {t(content.forecast.daily)}
            </h2>
            
            <!-- Horizontal Row of Day Cards (Map Style - Arrow + Box) -->
            <div class="flex flex-wrap justify-between gap-y-4">
              {forecastData.daily.slice(1, 7).map((day, index, arr) => {
                const isLast = index === arr.length - 1;
                return (
                  <>
                    <DailyForecastCard day={day} locale={locale} showDate={true} />
                    {!isLast && (
                      <div class="hidden md:block w-px h-12 bg-slate-300/50 dark:bg-slate-700/50 self-center"></div>
                    )}
                  </>
                );
              })}
            </div>
      </div>
        </>
      )}

    </div>
  </section>
  
  <!-- JSON-LD Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WeatherForecast",
    "name": t({ 
      it: "Meteo Vento Caldè", 
      en: "Caldè Wind Weather", 
      de: "Wetter Wind Caldè" 
    }),
    "description": t({ 
      it: "Previsioni vento e meteo live per vela e sport nautici a Caldè, Lago Maggiore.", 
      en: "Live wind and weather forecast for sailing and water sports at Caldè, Lake Maggiore.", 
      de: "Live-Wind- und Wettervorhersage für Segeln und Wassersport in Caldè, Lago Maggiore." 
    }),
    "location": {
      "@type": "Place",
      "name": "Caldè",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.9448,
        "longitude": 8.6612
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Castelveccana",
        "addressRegion": "VA",
        "addressCountry": "IT"
      }
    },
    "areaServed": [
      { "@type": "City", "name": t({ it: "Castelveccana", en: "Castelveccana", de: "Castelveccana" }) },
      { "@type": "City", "name": t({ it: "Porto Valtravaglia", en: "Porto Valtravaglia", de: "Porto Valtravaglia" }) },
      { "@type": "City", "name": t({ it: "Laveno-Mombello", en: "Laveno-Mombello", de: "Laveno-Mombello" }) },
      { "@type": "City", "name": t({ it: "Luino", en: "Luino", de: "Luino" }) },
      { "@type": "Place", "name": t({ it: "Alto Lago Maggiore", en: "Upper Lake Maggiore", de: "Oberer Lago Maggiore" }) }
    ],
    "provider": {
      "@type": "SportsOrganization",
      "name": "Circolo Nautico Caldè",
      "url": "https://cncvela.it"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": t({ 
        it: "Velisti, Windsurfer", 
        en: "Sailors, Windsurfers", 
        de: "Segler, Windsurfer" 
      })
    }
  })} />
</BaseLayout>

<style>
  /* ============================================
     CYBER-NAUTICAL DESIGN SYSTEM
     ============================================ */
  
  .cyber-panel {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgb(203 213 225);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.05);
  }
  
  :global(.dark) .cyber-panel {
    background: rgba(15, 23, 42, 0.8);
    border-color: rgba(6, 182, 212, 0.2);
  }
  
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgb(241 245 249);
    border-bottom: 1px solid rgb(226 232 240);
  }
  
  :global(.dark) .panel-header {
    background: rgba(30, 41, 59, 0.5);
    border-bottom-color: rgba(6, 182, 212, 0.1);
  }
  
  .panel-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(71 85 105);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  :global(.dark) .panel-title {
    color: rgb(34 211 238);
  }
  
  .panel-title svg {
    color: rgb(8 145 178);
  }
  
  :global(.dark) .panel-title svg {
    color: rgb(6 182 212);
  }
  
  .stat-card {
    text-align: center;
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgb(241 245 249);
    border: 1px solid rgb(226 232 240);
  }
  
  :global(.dark) .stat-card {
    background: rgba(30, 41, 59, 0.4);
    border-color: rgba(51, 65, 85, 0.3);
  }
  
  .stat-value {
    font-size: 1.875rem;
    font-weight: 900;
  }
  
  @media (min-width: 768px) {
    .stat-value {
      font-size: 2.25rem;
    }
  }
  
  .stat-unit {
    font-size: 1rem;
    font-weight: 700;
    margin-left: 0.25rem;
    opacity: 0.6;
  }
  
  .stat-label {
    font-size: 0.75rem;
    color: rgb(100 116 139);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }
  
  /* Hide scrollbar but allow scroll */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Daily Row Hover */
  .daily-row {
    transition: all 0.2s ease;
  }
  
  .daily-row:hover {
    transform: translateX(4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  
  /* Wind Indicator Animation */
  .wind-indicator svg {
    transition: transform 0.3s ease;
  }
  
  .daily-row:hover .wind-indicator svg {
    transform: scale(1.1);
  }
</style>

<script>
  // Auto-scroll hourly chart to current hour on mobile
  document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('hourly-chart-scroll');
    const currentHourBar = document.getElementById('current-hour-bar');
    
    if (scrollContainer && currentHourBar) {
      // Scroll to position current hour near the left (with some padding)
      const scrollPosition = currentHourBar.offsetLeft - 20;
      
      // Smooth scroll on mobile, instant on desktop (desktop shows all anyway)
      scrollContainer.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });
    }
  });
</script>
