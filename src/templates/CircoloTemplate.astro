---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MapEmbed from '../components/MapEmbed.astro';
import type { Locale } from '../i18n';

// Import data files
import content from '../data/circolo-content.json';
import contact from '../data/contact.json';
import boardMembers from '../data/board-members.json';
import documents from '../data/documents.json';
import membershipFees from '../data/membership-fees.json';
import boatStorage from '../data/boat-storage.json';
import bankDetails from '../data/bank-details.json';

// Import images
import heroImage from '../assets/images/atmosfera/lago-nuvole.jpg';
import spiaggiaImage from '../assets/images/spiaggia.png';
import sedeImage from '../assets/images/circolo.jpg';
import pontileImage from '../assets/images/pontile.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Helper to get localized text with fallback
const t = (obj: { it: string; en?: string; de?: string } | undefined, fallback = ''): string => {
  if (!obj) return fallback;
  return obj[locale] || obj.it || fallback;
};
---

<BaseLayout title={t(content.pageTitle)} description={t(content.pageDescription)} locale={locale}>
  <!-- Hero image -->
  <section class="relative h-[35vh] min-h-[250px] overflow-hidden">
    <Image 
      src={heroImage}
      alt={t(content.facilities.beach.title)}
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
  </section>
  
  <PageHeader title={t(content.pageTitle)} subtitle={t(content.pageDescription)} />

  <!-- Page Content -->
  <div class="bg-slate-200 dark:bg-slate-950">

  <!-- Chi Siamo -->
  <section id="chi-siamo" class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-6" style="font-size: var(--text-2xl);">
        {t(content.whoWeAre.title)}
      </h2>
      <article class="prose prose-lg dark:prose-invert max-w-none">
        <p set:html={t(content.whoWeAre.content)} />
      </article>
    </div>
  </section>

  <!-- Facilities Gallery -->
  <section id="strutture" class="py-12 md:py-16 bg-secondary">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-8 text-center" style="font-size: var(--text-2xl);">
        {t(content.facilities.title)}
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Beach -->
        <div class="group relative overflow-hidden rounded-xl aspect-[4/3]">
          <Image 
            src={spiaggiaImage}
            alt={t(content.facilities.beach.title)}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 100vw, 33vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
            <h3 class="font-bold text-lg">{t(content.facilities.beach.title)}</h3>
            <p class="text-sm text-white/80">{t(content.facilities.beach.shortDesc)}</p>
          </div>
        </div>
        
        <!-- Pontile -->
        <div class="group relative overflow-hidden rounded-xl aspect-[4/3]">
          <Image 
            src={pontileImage}
            alt={t(content.facilities.pontile.title)}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 100vw, 33vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
            <h3 class="font-bold text-lg">{t(content.facilities.pontile.title)}</h3>
            <p class="text-sm text-white/80">{t(content.facilities.pontile.shortDesc)}</p>
          </div>
        </div>
        
        <!-- Sede -->
        <div class="group relative overflow-hidden rounded-xl aspect-[4/3]">
          <Image 
            src={sedeImage}
            alt={t(content.facilities.sede.title)}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 100vw, 33vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
            <h3 class="font-bold text-lg">{t(content.facilities.sede.title)}</h3>
            <p class="text-sm text-white/80">{t(content.facilities.sede.shortDesc)}</p>
          </div>
        </div>
      </div>
      
      <!-- Facility Details -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <h3 class="font-bold text-lg mb-2">{t(content.facilities.beach.title)}</h3>
          <p class="text-sm text-muted">{t(content.facilities.beach.longDesc)}</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">{t(content.facilities.pontile.title)}</h3>
          <p class="text-sm text-muted">{t(content.facilities.pontile.longDesc)}</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">{t(content.facilities.sede.title)}</h3>
          <p class="text-sm text-muted">{t(content.facilities.sede.longDesc)}</p>
        </div>
      </div>
      
      <!-- Additional Facilities -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-accent-primary-dark)]/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-1">{t(content.facilities.boatStorage.title)}</h3>
              <p class="text-sm text-muted">{t(content.facilities.boatStorage.desc)}</p>
            </div>
          </div>
        </div>
        
        <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-accent-primary-dark)]/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-1">{t(content.facilities.buoys.title)}</h3>
              <p class="text-sm text-muted">{t(content.facilities.buoys.desc)}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Diventa Socio -->
  <section id="diventa-socio" class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-6" style="font-size: var(--text-2xl);">
        {t(content.membership.title)}
      </h2>
      <p class="text-muted mb-6">{t(content.membership.intro)}</p>
      <ul class="space-y-3 mb-8">
        {content.membership.benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>{t(benefit)}</span>
          </li>
        ))}
      </ul>
      <a href="circolo#quote" class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)] text-white font-bold uppercase tracking-wide rounded-lg hover:opacity-90 transition-opacity touch-target">
        {t(content.membership.viewFeesButton)}
      </a>
    </div>
  </section>

  <!-- Consiglio Direttivo -->
  <section id="consiglio" class="py-12 md:py-16 bg-secondary">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-8" style="font-size: var(--text-2xl);">
        {t(boardMembers.title)}
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {boardMembers.members.map((member, index) => (
          <div class:list={[
            "bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted",
            { "sm:col-span-2 lg:col-span-1": index === 0 }
          ]}>
            <div class="flex items-center gap-4">
              <div class:list={[
                "w-12 h-12 rounded-full flex items-center justify-center text-white font-bold",
                index === 0 
                  ? "bg-[var(--color-accent-secondary)] dark:bg-[var(--color-accent-secondary-dark)]" 
                  : "bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)]"
              ]}>
                {member.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
              </div>
              <div>
                <p class="font-bold">{member.name}</p>
                <p class="text-sm text-muted">{t(member.role)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Revisore e Probiviri -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        {boardMembers.auditor && (
          <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
            <h3 class="font-bold text-sm text-muted uppercase tracking-wide mb-3">{t(boardMembers.auditor.role)}</h3>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-sm font-bold">
                {boardMembers.auditor.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
              </div>
              <span class="font-medium">{boardMembers.auditor.name}</span>
            </div>
          </div>
        )}
        
        {boardMembers.probiviri && boardMembers.probiviri.members && boardMembers.probiviri.members.length > 0 && (
          <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
            <h3 class="font-bold text-sm text-muted uppercase tracking-wide mb-3">{t(boardMembers.probiviri.title)}</h3>
            <div class="flex flex-wrap gap-3">
              {boardMembers.probiviri.members.map((p) => (
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-xs font-bold">
                    {p.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
                  </div>
                  <span class="text-sm">{p.name}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Quote Associative -->
  <section id="quote" class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-4" style="font-size: var(--text-2xl);">
        {t(content.fees.title)}
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Membership Fees -->
        <div class="bg-secondary rounded-xl p-6">
          <h3 class="font-bold text-lg mb-4">{t(membershipFees.title)}</h3>
          <ul class="space-y-4">
            {membershipFees.items.map((item) => (
              <li class="flex justify-between items-start pb-3 border-b border-muted last:border-0 last:pb-0">
                <div>
                  <p class="font-medium">{t(item.name)}</p>
                  {item.note && <p class="text-xs text-muted">{t(item.note)}</p>}
                </div>
                <p class="font-bold text-accent">€{item.price.toFixed(2)}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Boat Storage Fees -->
        <div class="space-y-6">
          <div class="bg-secondary rounded-xl p-6">
            <h3 class="font-bold text-lg mb-1">{t(boatStorage.buoy.title)}</h3>
            <p class="text-xs text-muted mb-4">{t(boatStorage.buoy.note)}</p>
            <ul class="space-y-3">
              {boatStorage.buoy.items.map((item) => (
                <li class="flex justify-between items-center text-sm">
                  <span>{t(item.name)}</span>
                  <span class="font-bold">€{item.price.toFixed(2)}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <div class="bg-secondary rounded-xl p-6">
            <h3 class="font-bold text-lg mb-4">{t(boatStorage.dinghy.title)}</h3>
            <ul class="space-y-3">
              {boatStorage.dinghy.items.map((item) => (
                <li class="flex justify-between items-center text-sm">
                  <span>{t(item.name)}</span>
                  <span class="font-bold">€{item.price.toFixed(2)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Bank Details -->
      <div class="mt-8 p-6 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-accent-primary-dark)]/10 rounded-xl border border-[var(--color-accent-primary)]/20 dark:border-[var(--color-accent-primary-dark)]/20">
        <h3 class="font-bold mb-4">{t(content.bankDetailsLabels.title)}</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="font-medium text-muted sm:w-32">{t(content.bankDetailsLabels.accountHolder)}:</dt>
            <dd>{bankDetails.accountHolder}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="font-medium text-muted sm:w-32">{t(content.bankDetailsLabels.bank)}:</dt>
            <dd>{bankDetails.bankName} - {bankDetails.branch}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="font-medium text-muted sm:w-32">IBAN:</dt>
            <dd class="font-mono break-all">{bankDetails.iban}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Documenti -->
  <section id="documenti" class="py-12 md:py-16 bg-secondary">
    <div class="max-w-4xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-8" style="font-size: var(--text-2xl);">
        {t(content.documentsLabels.title)}
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {documents.items.map((doc) => (
          <a
            href={doc.url}
            class="flex flex-col items-center gap-3 p-6 bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl border border-muted hover:border-[var(--color-accent-primary)] dark:hover:border-[var(--color-accent-primary-dark)] hover:shadow-lg transition-all touch-target text-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="w-14 h-14 bg-[var(--color-accent-primary)]/10 dark:bg-[var(--color-accent-primary-dark)]/10 rounded-xl flex items-center justify-center">
              {doc.icon === 'users' ? (
                <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              ) : doc.icon === 'certificate' ? (
                <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              ) : (
                <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              )}
            </div>
            <span class="font-bold">{t(doc.name)}</span>
            <span class="text-xs text-accent">{t(content.documentsLabels.downloadPdf)} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Iscrizione al Circolo -->
  <section id="iscrizione" class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-4 text-center" style="font-size: var(--text-2xl);">
        {t(content.membership.title)}
      </h2>
      
      <div class="bg-secondary rounded-xl p-8 border border-muted">
        <h3 class="font-bold text-lg mb-4 text-center">{t(content.registration.title)}</h3>
        
        <ol class="space-y-4 mb-8 text-sm">
          {content.registration.steps.map((step, idx) => (
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-accent-primary)] text-white flex items-center justify-center text-xs font-bold">{idx + 1}</span>
              <span set:html={t(step)} />
            </li>
          ))}
        </ol>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="documenti/iscrizione-moduli.pdf"
            download
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[var(--color-accent-primary)] dark:bg-[var(--color-accent-primary-dark)] text-white font-bold uppercase tracking-wide rounded-lg hover:opacity-90 transition-opacity touch-target"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {t(content.registration.downloadButton)}
          </a>
          <a
            href={`mailto:${contact.email}?subject=Iscrizione al Circolo`}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[var(--color-accent-secondary)] dark:bg-[var(--color-accent-secondary-dark)] text-white font-bold uppercase tracking-wide rounded-lg hover:opacity-90 transition-opacity touch-target"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {t(content.registration.sendButton)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contatti -->
  <section id="contatti" class="py-12 md:py-16 bg-secondary">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <h2 class="text-2xl font-black mb-8" style="font-size: var(--text-2xl);">
        {t(content.contactLabels.title)}
      </h2>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Contact Info -->
        <div class="space-y-6">
          <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
            <h3 class="font-bold text-lg mb-4">{t(content.contactLabels.clubAddress)}</h3>
            <address class="not-italic space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <p class="font-medium">{contact.clubName}</p>
                  <p>{contact.address.street}</p>
                  <p>{contact.address.postalCode} {contact.address.city} ({contact.address.province})</p>
                </div>
              </div>
              
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="link">{contact.phone}</a>
              </div>
              
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <a href={`mailto:${contact.email}`} class="link">{contact.email}</a>
              </div>
            </address>
          </div>
          
          <div class="bg-[var(--color-bg-primary)] dark:bg-[var(--color-bg-primary-dark)] rounded-xl p-6 border border-muted">
            <h3 class="font-bold text-lg mb-2">{t(content.contactLabels.fiscalData)}</h3>
            <p class="text-sm text-muted">{contact.legalName}</p>
            <p class="text-sm mt-2">
              <span class="text-muted">C.F.:</span> {contact.fiscalCode}
            </p>
            <p class="text-sm">
              <span class="text-muted">P.IVA:</span> {contact.vatNumber}
            </p>
          </div>
        </div>
        
        <!-- Map -->
        <MapEmbed 
          id="map-container-circolo"
          loadMapLabel={t(content.contactLabels.loadMap)}
          class="min-h-[300px] lg:min-h-full"
        />
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

