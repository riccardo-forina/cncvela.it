---
import '../styles/global.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/800.css';
import '@fontsource/dm-sans/900.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocaleFromUrl, defaultLocale, locales, t, ogLocaleTags, type Locale } from '../i18n';

interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  breadcrumbs?: BreadcrumbItem[];
  locale?: Locale;
}

const { 
  title, 
  description = "Circolo Nautico Caldè - Scuola Vela e Regate sul Lago Maggiore",
  image = "images/logo-square.png"
} = Astro.props;
const currentPath = Astro.url.pathname;
const baseEnv = import.meta.env.BASE_URL;

// Get current locale and build base path with locale
const locale = getLocaleFromUrl(Astro.url);
const localePrefix = locale === defaultLocale ? '' : `${locale}/`;
const base = baseEnv.endsWith('/') ? `${baseEnv}${localePrefix}` : `${baseEnv}/${localePrefix}`;

// Get site URL from Astro config (configured in astro.config.mjs)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const baseUrl = baseEnv.replace(/\/$/, '');
const fullSiteUrl = `${siteUrl}${baseUrl}`;

// Production URL (always points to the real site)
const productionUrl = 'https://www.cncvela.it';

// Check if we're on GitHub Pages (staging)
const isGitHubPages = siteUrl.includes('github.io');

// Build canonical URL - always points to production
const pagePath = currentPath.replace(baseUrl, '').replace(/^\/+/, '');
const canonicalUrl = pagePath ? `${productionUrl}/${pagePath}` : productionUrl;

// Build alternate language URLs for hreflang tags
// Remove locale prefix from path to get the base page path
const pagePathWithoutLocale = pagePath.replace(/^(en|de)\//, '').replace(/^(en|de)$/, '');
const getAlternateUrl = (loc: Locale) => {
  if (loc === defaultLocale) {
    // Italian (default) - no prefix
    return pagePathWithoutLocale ? `${productionUrl}/${pagePathWithoutLocale}` : productionUrl;
  }
  // Other languages - add prefix
  return pagePathWithoutLocale ? `${productionUrl}/${loc}/${pagePathWithoutLocale}` : `${productionUrl}/${loc}/`;
};
const alternateUrls = locales.map(loc => ({ locale: loc, url: getAlternateUrl(loc) }));

// Robots directive - noindex on staging, index on production
const robotsContent = isGitHubPages ? 'noindex, nofollow' : 'index, follow';

const fullTitle = `${title} | CNC Caldè`;
const ogImage = `${fullSiteUrl}/${image}`;

// JSON-LD Structured Data for the organization (Site-Wide SEO, i18n aware)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "name": t('organization.name', locale),
  "alternateName": ["CNC Vela", "CNC Caldè"],
  "url": "https://cncvela.it",
  "logo": "https://cncvela.it/images/logo-square.png",
  "description": t('organization.description', locale),
  "telephone": "+39 333 9769317",
  "email": "segreteria@cncvela.it",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": t('organization.streetAddress', locale),
    "addressLocality": t('organization.addressLocality', locale),
    "addressRegion": t('organization.addressRegion', locale),
    "postalCode": t('organization.postalCode', locale),
    "addressCountry": t('organization.addressCountry', locale)
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.9606,
    "longitude": 8.6469
  },
  "areaServed": [
    { "@type": "City", "name": t('organization.areaServed.castelveccana', locale) },
    { "@type": "City", "name": t('organization.areaServed.luino', locale) },
    { "@type": "City", "name": t('organization.areaServed.laveno', locale) },
    { "@type": "City", "name": t('organization.areaServed.portoValtravaglia', locale) },
    { "@type": "Place", "name": t('organization.areaServed.altoLago', locale) },
    { "@type": "Place", "name": t('organization.areaServed.varese', locale) }
  ],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=100039811966520",
    "https://www.instagram.com/circolo_nautico_calde"
  ],
  "sport": "Sailing",
  "foundingDate": "1970",
  "memberOf": {
    "@type": "Organization",
    "name": "Federazione Italiana Vela",
    "alternateName": "FIV"
  }
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Alternate Language URLs (hreflang) -->
    {alternateUrls.map(({ locale: loc, url }) => (
      <link rel="alternate" hreflang={loc} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAlternateUrl(defaultLocale)} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocaleTags[locale]} />
    <meta property="og:site_name" content="Circolo Nautico Caldè" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Additional SEO -->
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Circolo Nautico Caldè A.S.D." />
    <meta name="geo.region" content="IT-VA" />
    <meta name="geo.placename" content="Castelveccana" />
    <meta name="geo.position" content="45.9448;8.6612" />
    <meta name="ICBM" content="45.9448, 8.6612" />
    
    <!-- Favicon and Apple Touch Icon -->
    <base href={base.endsWith('/') ? base : base + '/'} />
    <link rel="icon" type="image/svg+xml" href="images/logo-round.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="images/logo-square.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="images/logo-square.png" />
    <link rel="manifest" href="manifest.json" />
    
    <!-- Fonts: Self-hosted via @fontsource for better performance -->
    
    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] dark:bg-[var(--color-bg-primary-dark)] dark:text-[var(--color-text-primary-dark)]">
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">
      Vai al contenuto principale
    </a>
    
    <!-- Header (hidden on mobile, visible on tablet+) -->
    <Header currentPath={currentPath} />
    
    <!-- Main Content -->
    <main id="main-content" class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>
    
    <!-- Footer -->
    <Footer />
    
    <!-- Bottom Navigation (mobile only) -->
    <BottomNav currentPath={currentPath} />
    
    <!-- Cookie Consent Banner -->
    <CookieConsent />
  </body>
</html>

<style>
  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    html {
      color-scheme: dark;
    }
  }
</style>

